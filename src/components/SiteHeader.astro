---
import { getTranslations } from "../data/i18n";
import type { Locale } from "../data/locales";
import { getLocaleNavigationRoutes, localeRouteConfig } from "../data/locale-routes";

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
const localizedRoutes = localeRouteConfig[locale];
const languageRoutes = getLocaleNavigationRoutes(Astro.url.pathname);
const languageLabel = locale === "en" ? "Language" : "Idioma";
const navItems = [
  { label: t.tools, href: localizedRoutes.tools },
  { label: t.categories, href: localizedRoutes.categories },
];
---

<header>
  <div class="container header-inner">
    <a href={localizedRoutes.home} class="logo">USEVO TOOLS</a>

    <nav>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={localizedRoutes.tools} class="nav-button">{t.exploreTools}</a>
      <span class="language-switcher" role="group" aria-label={languageLabel}>
        {([['pt-BR', 'PT'], ['en', 'EN'], ['es', 'ES']] as const).map(([option, label]) => (
          <a
            class:list={{ "language-option": true, current: locale === option }}
            href={languageRoutes[option]}
            aria-current={locale === option ? "page" : undefined}
            aria-label={`${languageLabel}: ${label}`}
          >{label}</a>
        ))}
      </span>
    </nav>
  </div>
</header>

<style>
  header {
    height: 82px;
    border-bottom: 1px solid #eeeeee;
    background: #ffffff;
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
    text-decoration: none;
    color: inherit;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    color: #4b5563;
  }

  nav a {
    text-decoration: none;
    color: inherit;
  }

  nav a:hover {
    color: #315bea;
  }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-left: 4px;
    padding: 2px;
    border: 1px solid #d9dee8;
    border-radius: 8px;
  }

  .language-switcher .language-option {
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
  }

  .language-switcher .language-option.current {
    background: #eef2ff;
    color: #315bea;
  }

  .nav-button {
    background: #172033;
    color: #ffffff;
    padding: 13px 20px;
    border-radius: 8px;
    font-weight: 600;
  }

  nav .nav-button:hover {
    background: #315bea;
    color: #ffffff;
  }

  nav .nav-button:focus-visible {
    outline: 3px solid #93c5fd;
    outline-offset: 3px;
    color: #ffffff;
  }

  @media (max-width: 650px) {
    .container {
      width: min(100% - 28px, 1180px);
    }

    header {
      height: auto;
      padding: 18px 0;
    }

    .header-inner {
      height: auto;
      flex-wrap: wrap;
      gap: 16px;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 8px;
      min-width: 0;
    }

    nav a:not(.nav-button):not(.language-option) {
      display: none;
    }

    nav .language-switcher .language-option {
      display: inline-flex;
    }

    .nav-button {
      min-height: 38px;
      padding: 10px;
      font-size: 13px;
      white-space: nowrap;
    }

    .language-switcher {
      flex: 0 0 auto;
      margin-left: 0;
    }
  }
</style>
