---
import { getTranslations } from "../data/i18n";
import type { Locale } from "../data/locales";
import { getLocaleNavigationRoutes, localeRouteConfig } from "../data/locale-routes";

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
const localizedRoutes = localeRouteConfig[locale];
const languageRoutes = getLocaleNavigationRoutes(Astro.url.pathname);
const languageLabel = locale === "en" ? "Language" : "Idioma";
const mobileExploreLabel = locale === "en" ? "Explore" : "Explorar";
const navItems = [
  { label: t.tools, href: localizedRoutes.tools },
  { label: t.categories, href: localizedRoutes.categories },
];
---

<header>
  <div class="container header-inner">
    <a href={localizedRoutes.home} class="logo">USEVO TOOLS</a>

    <nav>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={localizedRoutes.tools} class="nav-button"><span class="nav-button__full">{t.exploreTools}</span><span class="nav-button__mobile">{mobileExploreLabel}</span></a>
      <span class="language-switcher" role="group" aria-label={languageLabel}>
        {([['pt-BR', 'PT'], ['en', 'EN'], ['es', 'ES']] as const).map(([option, label]) => (
          <a
            class:list={{ "language-option": true, current: locale === option }}
            href={languageRoutes[option]}
            aria-current={locale === option ? "page" : undefined}
            aria-label={`${languageLabel}: ${label}`}
          >{label}</a>
        ))}
      </span>
    </nav>
  </div>
</header>

<style>
  header {
    height: 82px;
    border-bottom: 1px solid #eeeeee;
    background: #ffffff;
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
    text-decoration: none;
    color: inherit;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    color: #4b5563;
  }

  nav a {
    text-decoration: none;
    color: inherit;
  }

  nav a:hover {
    color: #315bea;
  }

  nav a:focus-visible {
    outline: 3px solid #93c5fd;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-left: 4px;
    padding: 2px;
    border: 1px solid #d9dee8;
    border-radius: 8px;
  }

  .language-switcher .language-option {
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
  }

  .language-switcher .language-option.current {
    background: #eef2ff;
    color: #315bea;
  }

  nav .nav-button {
    background: #172033;
    color: #ffffff;
    padding: 13px 20px;
    border-radius: 8px;
    font-weight: 600;
  }

  nav .nav-button:hover {
    background: #315bea;
    color: #ffffff;
  }

  nav .nav-button:focus-visible {
    outline: 3px solid #93c5fd;
    outline-offset: 3px;
    color: #ffffff;
  }

  .nav-button__mobile { display: none; }

  @media (max-width: 650px) {
    .container {
      width: min(100% - 28px, 1180px);
    }

    header {
      height: auto;
      padding: 18px 0;
    }

    .header-inner {
      height: auto;
      flex-wrap: wrap;
      gap: 16px;
    }

    nav {
      width: 100%;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: flex-start;
      gap: 8px;
      min-width: 0;
    }

    nav > a:first-child:not(.nav-button):not(.language-option) {
      flex: 0 0 100%;
    }

    nav > a:nth-child(2):not(.nav-button):not(.language-option) {
      flex: 1 1 0;
    }

    nav > a:not(.nav-button):not(.language-option) {
      display: inline-flex;
      flex: 1 1 calc(50% - 4px);
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid #d9dee8;
      border-radius: 8px;
    }

    nav .language-switcher .language-option {
      display: inline-flex;
    }

    nav .nav-button {
      display: inline-flex;
      flex: 1 1 0;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 12px;
      font-size: 13px;
      white-space: nowrap;
    }

    nav .language-switcher {
      flex: 0 0 100%;
      min-height: 44px;
      margin-left: 0;
      justify-content: flex-start;
    }

    .nav-button__full { display: none; }
    .nav-button__mobile { display: inline; }
  }

  @media (max-width: 480px) {
    header,
    header .container,
    header .header-inner,
    header nav,
    header nav > a,
    header .language-switcher {
      box-sizing: border-box;
      min-width: 0;
    }

    header {
      width: 100%;
      padding: 10px 0;
    }

    header .container {
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0 14px;
    }

    header .header-inner {
      width: 100%;
      gap: 8px;
    }

    header .logo {
      font-size: 24px;
      line-height: 1;
    }

    header nav {
      display: grid;
      width: 100%;
      max-width: 100%;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 6px;
    }

    header nav > a:first-child:not(.nav-button):not(.language-option),
    header nav .language-switcher {
      grid-column: 1 / -1;
      width: 100%;
    }

    header nav > a:not(.language-option),
    header nav .nav-button {
      width: 100%;
      min-height: 56px;
      padding: 8px 10px;
    }

    header nav .language-switcher {
      min-height: 44px;
      padding: 2px;
    }

    header nav .language-switcher .language-option {
      min-height: 38px;
      min-width: 36px;
    }
  }
</style>
