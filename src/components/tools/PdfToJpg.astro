---
import type { Locale } from "../../data/locales";
const { locale = "pt-BR" } = Astro.props as { locale?: Locale };
const copy = { "pt-BR": { title:"PDF para JPG", intro:"Converta páginas de PDF em JPG neste navegador.", select:"Selecionar PDF", all:"Todas as páginas", selected:"Páginas selecionadas", pages:"Páginas", example:"Exemplo: 1-3, 5, 7-9", quality:"Qualidade", low:"Baixa", medium:"Média", high:"Alta", process:"Converter para JPG", clear:"Limpar", download:"Baixar JPG", zip:"Baixar ZIP", processing:"Convertendo página {page} de {total}", privacy:"O arquivo não é enviado a um servidor.", noFile:"Selecione um PDF.", notPdf:"Selecione um arquivo PDF.", tooLarge:"O PDF deve ter no máximo 20 MB.", empty:"O PDF não possui páginas.", invalid:"Não foi possível ler este PDF. Ele pode estar inválido ou corrompido.", protected:"PDFs protegidos por senha não são compatíveis.", invalidRange:"Informe páginas e intervalos válidos.", missing:"Uma página informada não existe neste PDF.", pageLimit:"A seleção excede o limite de páginas para esta qualidade.", worker:"Não foi possível carregar o renderizador de PDF.", canvas:"A resolução desta página excede o limite do dispositivo.", blob:"Não foi possível criar a imagem JPG.", memory:"Não há memória suficiente para concluir a conversão.", result:"O resultado excede 50 MB e foi descartado.", zipError:"Não foi possível criar o arquivo ZIP.", unexpected:"Ocorreu uma falha inesperada.", limited:"A resolução foi reduzida para caber no limite do dispositivo.", ready:"Resultado pronto para download.", info:"{name} · {size} · {pages} páginas", zipName:"pdf-para-jpg.zip" }, en: { title:"PDF to JPG", intro:"Convert PDF pages to JPG in this browser.", select:"Select PDF", all:"All pages", selected:"Selected pages", pages:"Pages", example:"Example: 1-3, 5, 7-9", quality:"Quality", low:"Low", medium:"Medium", high:"High", process:"Convert to JPG", clear:"Clear", download:"Download JPG", zip:"Download ZIP", processing:"Converting page {page} of {total}", privacy:"The file is not sent to a server.", noFile:"Select a PDF.", notPdf:"Select a PDF file.", tooLarge:"The PDF must be 20 MB or smaller.", empty:"The PDF has no pages.", invalid:"This PDF could not be read. It may be invalid or corrupted.", protected:"Password-protected PDFs are not supported.", invalidRange:"Enter valid pages and ranges.", missing:"One requested page does not exist in this PDF.", pageLimit:"The selection exceeds the page limit for this quality.", worker:"The PDF renderer could not be loaded.", canvas:"This page resolution exceeds the device limit.", blob:"The JPG image could not be created.", memory:"There is not enough memory to finish conversion.", result:"The result exceeds 50 MB and was discarded.", zipError:"The ZIP file could not be created.", unexpected:"An unexpected error occurred.", limited:"Resolution was reduced to fit the device limit.", ready:"Your result is ready to download.", info:"{name} · {size} · {pages} pages", zipName:"pdf-to-jpg.zip" }, es: { title:"PDF a JPG", intro:"Convierte páginas PDF a JPG en este navegador.", select:"Seleccionar PDF", all:"Todas las páginas", selected:"Páginas seleccionadas", pages:"Páginas", example:"Ejemplo: 1-3, 5, 7-9", quality:"Calidad", low:"Baja", medium:"Media", high:"Alta", process:"Convertir a JPG", clear:"Limpiar", download:"Descargar JPG", zip:"Descargar ZIP", processing:"Convirtiendo página {page} de {total}", privacy:"El archivo no se envía a un servidor.", noFile:"Selecciona un PDF.", notPdf:"Selecciona un archivo PDF.", tooLarge:"El PDF debe tener como máximo 20 MB.", empty:"El PDF no tiene páginas.", invalid:"No se pudo leer este PDF. Puede ser inválido o estar dañado.", protected:"Los PDF protegidos con contraseña no son compatibles.", invalidRange:"Introduce páginas e intervalos válidos.", missing:"Una página indicada no existe en este PDF.", pageLimit:"La selección supera el límite de páginas para esta calidad.", worker:"No se pudo cargar el renderizador de PDF.", canvas:"La resolución de esta página supera el límite del dispositivo.", blob:"No se pudo crear la imagen JPG.", memory:"No hay memoria suficiente para terminar la conversión.", result:"El resultado supera 50 MB y se descartó.", zipError:"No se pudo crear el archivo ZIP.", unexpected:"Ocurrió un error inesperado.", limited:"La resolución se redujo para ajustarse al límite del dispositivo.", ready:"El resultado está listo para descargar.", info:"{name} · {size} · {pages} páginas", zipName:"pdf-a-jpg.zip" } }[locale];
---
<section class="pdf-to-jpg tool-card" aria-labelledby="pdfToJpgTitle" data-copy={JSON.stringify(copy)} data-locale={locale}>
  <h1 id="pdfToJpgTitle">{copy.title}</h1><p>{copy.intro}</p>
  <label class="drop" for="pdfToJpgInput"><strong>{copy.select}</strong><span>{copy.privacy}</span></label><input id="pdfToJpgInput" type="file" accept="application/pdf" />
  <p id="pdfToJpgInfo" hidden aria-live="polite"></p>
  <fieldset><legend>Modo</legend><label><input type="radio" name="pdfJpgMode" value="all" checked /> {copy.all}</label><label><input type="radio" name="pdfJpgMode" value="selected" /> {copy.selected}</label></fieldset>
  <div id="pdfToJpgRanges" hidden><label for="pdfToJpgPages">{copy.pages}</label><input id="pdfToJpgPages" placeholder="1-3, 5, 7-9" aria-describedby="pdfToJpgExample" /><small id="pdfToJpgExample">{copy.example}</small></div>
  <fieldset><legend>{copy.quality}</legend><label><input type="radio" name="pdfJpgQuality" value="low" /> {copy.low}</label><label><input type="radio" name="pdfJpgQuality" value="medium" checked /> {copy.medium}</label><label><input type="radio" name="pdfJpgQuality" value="high" /> {copy.high}</label></fieldset>
  <p id="pdfToJpgProgress" aria-live="polite" hidden></p><p id="pdfToJpgError" role="alert" hidden></p><p id="pdfToJpgSuccess" aria-live="polite" hidden></p>
  <div class="actions"><button id="pdfToJpgProcess" type="button">{copy.process}</button><a id="pdfToJpgDownload" hidden></a><button id="pdfToJpgClear" type="button">{copy.clear}</button></div>
</section>
<script>
 import { PDF_TO_JPG_LIMITS, PDF_JPG_QUALITY, PdfToJpgError, assertPdfJpgAggregateSize, assertPdfJpgLimits, createPdfJpgZip, getPdfJpgFileName, getPdfJpgPages } from "../../lib/pdf-to-jpg";
 import { PdfPageRangeError } from "../../lib/pdf-page-ranges";
 import { openPdfForRendering, renderPdfPageToJpg } from "../../lib/pdf-page-renderer";
 const root=document.querySelector<HTMLElement>(".pdf-to-jpg"); if(root){ const c=JSON.parse(root.dataset.copy??"{}") as Record<string,string>; const locale=root.dataset.locale as "pt-BR"|"en"|"es"; const input=root.querySelector<HTMLInputElement>("#pdfToJpgInput")!, info=root.querySelector<HTMLElement>("#pdfToJpgInfo")!, ranges=root.querySelector<HTMLElement>("#pdfToJpgRanges")!, pages=root.querySelector<HTMLInputElement>("#pdfToJpgPages")!, progress=root.querySelector<HTMLElement>("#pdfToJpgProgress")!, error=root.querySelector<HTMLElement>("#pdfToJpgError")!, success=root.querySelector<HTMLElement>("#pdfToJpgSuccess")!, process=root.querySelector<HTMLButtonElement>("#pdfToJpgProcess")!, clear=root.querySelector<HTMLButtonElement>("#pdfToJpgClear")!, download=root.querySelector<HTMLAnchorElement>("#pdfToJpgDownload")!; const mode=[...root.querySelectorAll<HTMLInputElement>('input[name="pdfJpgMode"]')], quality=[...root.querySelectorAll<HTMLInputElement>('input[name="pdfJpgQuality"]')]; let file:File|undefined, bytes:ArrayBuffer|undefined, documentPdf:any, url:string|undefined;
 const revoke=()=>{if(url)URL.revokeObjectURL(url);url=undefined;download.hidden=true}; const fail=(m:string)=>{error.textContent=m;error.hidden=false;success.hidden=true}; const selected=()=>mode.find(x=>x.checked)?.value??"all"; const selectedQuality=()=>quality.find(x=>x.checked)?.value as "low"|"medium"|"high"; const toggle=()=>ranges.hidden=selected()==="all"; const size=(n:number)=>`${(n/1048576).toFixed(1)} MB`; const message=(e:unknown)=>{const s=e instanceof Error?e.message.toLowerCase():"";if(e instanceof PdfPageRangeError)return e.code==="out-of-bounds"?c.missing:c.invalidRange;if(e instanceof PdfToJpgError)return e.code==="too-many-pages"?c.pageLimit:e.code==="canvas-too-large"?c.canvas:e.code==="blob-failed"?c.blob:e.code==="result-too-large"?c.result:c.invalidRange;if(s.includes("password")||s.includes("encrypted"))return c.protected;if(s.includes("worker"))return c.worker;if(s.includes("memory")||s.includes("allocation"))return c.memory;return c.invalid};
 const dispose=async()=>{await documentPdf?.destroy?.();documentPdf=undefined}; const load=async(f?:File)=>{revoke();error.hidden=true;await dispose();file=f;bytes=undefined;info.hidden=true;if(!f)return;if(f.type!=="application/pdf"&&!f.name.toLowerCase().endsWith(".pdf")){fail(c.notPdf);return}if(f.size>PDF_TO_JPG_LIMITS.sourceBytes){fail(c.tooLarge);return}try{bytes=await f.arrayBuffer();documentPdf=await openPdfForRendering(bytes);if(!documentPdf.numPages){fail(c.empty);return}info.textContent=c.info.replace("{name}",f.name).replace("{size}",size(f.size)).replace("{pages}",documentPdf.numPages);info.hidden=false}catch(e){fail(message(e))}};
 input.addEventListener("change",()=>void load(input.files?.[0]));mode.forEach(x=>x.addEventListener("change",toggle));process.addEventListener("click",async()=>{if(!file||!documentPdf){fail(c.noFile);return}error.hidden=true;revoke();process.disabled=true;clear.disabled=true;try{const chosen=getPdfJpgPages(pages.value,documentPdf.numPages,selected()==="all");const q=selectedQuality();assertPdfJpgLimits(file.size,chosen,q);const output:any[]=[];let limited=false;for(let i=0;i<chosen.length;i++){progress.textContent=c.processing.replace("{page}",String(i+1)).replace("{total}",String(chosen.length));progress.hidden=false;const rendered=await renderPdfPageToJpg(await documentPdf.getPage(chosen[i]),q);limited ||= rendered.wasLimited;output.push({name:getPdfJpgFileName(locale,chosen[i],documentPdf.numPages),bytes:rendered.bytes});assertPdfJpgAggregateSize(output)}const single=output.length===1;const result=single?output[0].bytes:await createPdfJpgZip(output);url=URL.createObjectURL(new Blob([result],{type:single?"image/jpeg":"application/zip"}));download.href=url;download.download=single?output[0].name:c.zipName;download.textContent=single?c.download:c.zip;download.hidden=false;success.textContent=limited?`${c.ready} ${c.limited}`:c.ready;success.hidden=false}catch(e){fail(message(e))}finally{progress.hidden=true;process.disabled=false;clear.disabled=false}});clear.addEventListener("click",()=>{revoke();void dispose();file=undefined;bytes=undefined;input.value="";pages.value="";info.hidden=true;error.hidden=true;success.hidden=true});window.addEventListener("pagehide",()=>{revoke();void dispose()});toggle(); }
</script>
<style>.pdf-to-jpg{display:grid;gap:1rem}.drop{display:grid;gap:.35rem;padding:1.5rem;border:2px dashed #94a3b8;border-radius:.75rem;text-align:center;cursor:pointer}.drop span,small{color:#64748b}#pdfToJpgInput{position:absolute;width:1px;height:1px;opacity:0}fieldset,#pdfToJpgRanges{display:grid;gap:.55rem;border:0;padding:0}.actions{display:flex;gap:.75rem;flex-wrap:wrap}button,a{padding:.75rem 1rem;border-radius:.5rem}#pdfToJpgError{color:#b91c1c}#pdfToJpgSuccess{color:#15803d}</style>
