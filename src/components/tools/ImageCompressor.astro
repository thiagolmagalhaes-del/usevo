---
import type { Locale } from "../../data/locales";
const { locale = "en" } = Astro.props as { locale?: Locale };
const copy = locale === "pt-BR" ? {
  title: "Comprimir imagem", drop: "Arraste e solte uma imagem aqui ou clique para selecionar", file: "Arquivo", original: "Tamanho original", quality: "Qualidade", processing: "Processando...", final: "Tamanho final", reduction: "Redução", download: "Baixar imagem", formats: "Formatos aceitos: JPG, PNG, WebP", noFile: "Nenhum arquivo selecionado.", tooLarge: "O arquivo excede o limite de {size} MB.", noReduction: "Não foi obtida uma redução efetiva.", error: "Erro ao comprimir a imagem. O arquivo pode ser muito grande ou inválido.",
} : locale === "es" ? {
  title: "Comprimir imagen", drop: "Arrastra y suelta una imagen aquí o haz clic para seleccionarla", file: "Archivo", original: "Tamaño original", quality: "Calidad", processing: "Procesando...", final: "Tamaño final", reduction: "Reducción", download: "Descargar imagen", formats: "Formatos aceptados: JPG, PNG, WebP", noFile: "No se seleccionó ningún archivo.", tooLarge: "El archivo supera el límite de {size} MB.", noReduction: "No se obtuvo una reducción efectiva.", error: "Error al comprimir la imagen. El archivo puede ser demasiado grande o no válido.",
} : {
  title: "Compress Image", drop: "Drag and drop an image here or click to select", file: "File", original: "Original size", quality: "Quality", processing: "Processing...", final: "Final size", reduction: "Reduction", download: "Download Image", formats: "Supported formats: JPG, PNG, WebP", noFile: "No file selected.", tooLarge: "File exceeds the limit of {size} MB.", noReduction: "No effective reduction was achieved.", error: "Error compressing the image. The file may be too large or invalid.",
};
---
<div class="tool-card card">
  <h1 style="font-size: 1.5em; margin-block: 0.83em;">{copy.title}</h1>
  <label id="dropArea" class="drop" for="fileInput">{copy.drop}</label>
  <input id="fileInput" class="file-input" type="file" accept="image/*" />
  <div id="fileInfo" style="display:none">
    <div>{copy.file}: <span id="fileName"></span></div>
    <div>{copy.original}: <span id="originalSize"></span></div>
    <img id="filePreview" class="file-preview" alt="" />
    <label>{copy.quality}: <input id="quality" type="range" min="0.1" max="1" step="0.05" value="0.8"></label>
    <button id="compressBtn">{copy.title}</button>
  </div>
  <div id="processing" style="display:none">{copy.processing}</div>
  <div id="result" style="display:none">
    <div>{copy.final}: <span id="finalSize"></span></div>
    <div>{copy.reduction}: <span id="reduction"></span></div>
    <a id="downloadLink" href="#" download>{copy.download}</a>
  </div>
  <div id="error" class="error" style="display:none"></div>
</div>

<style>
.drop { padding: 18px; border: 2px dashed #d7dce5; border-radius:12px; text-align:center; cursor:pointer; }
.file-input { position:absolute; width:1px; height:1px; opacity:0; overflow:hidden; }
.file-preview { display:block; max-width:100%; max-height:240px; margin:16px auto 0; border-radius:8px; }
.error { color: #7a1f00; background:#fff1f0; padding:8px; border-radius:8px; margin-top:8px; }
</style>

<script type="module" define:vars={{ copy }}>
  import imageCompression from 'browser-image-compression';

  const dropArea = document.getElementById('dropArea');
  const fileInput = document.getElementById('fileInput');
  const fileInfo = document.getElementById('fileInfo');
  const fileNameEl = document.getElementById('fileName');
  const originalSizeEl = document.getElementById('originalSize');
  const filePreview = document.getElementById('filePreview');
  const qualityInput = document.getElementById('quality');
  const compressBtn = document.getElementById('compressBtn');
  const processing = document.getElementById('processing');
  const result = document.getElementById('result');
  const finalSizeEl = document.getElementById('finalSize');
  const reductionEl = document.getElementById('reduction');
  const downloadLink = document.getElementById('downloadLink');
  const errorEl = document.getElementById('error');

  let currentFile = null;
  let currentImageObjectUrl = null;
  let previewObjectUrl = null;
  const IMAGE_MAX_FILE = 10 * 1024 * 1024; // 10 MB per image limit (client-side)

  function humanSize(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  dropArea.addEventListener('dragover', (e) => { e.preventDefault(); dropArea.style.borderColor = '#315bea'; });
  dropArea.addEventListener('dragleave', () => { dropArea.style.borderColor = '#d7dce5'; });
  dropArea.addEventListener('drop', (e) => {
    e.preventDefault(); dropArea.style.borderColor = '#d7dce5';
    const f = e.dataTransfer.files[0];
    handleFile(f);
  });

  fileInput.addEventListener('change', (e) => {
    const f = e.target.files[0];
    handleFile(f);
  });

  function showError(msg) { errorEl.style.display = 'block'; errorEl.textContent = msg; }
  function clearError() { errorEl.style.display = 'none'; errorEl.textContent = ''; }

  function handleFile(file) {
    clearError();
    if (previewObjectUrl) { URL.revokeObjectURL(previewObjectUrl); previewObjectUrl = null; }
    filePreview.removeAttribute('src');
    if (!file) return;
    const allowed = ['image/jpeg','image/png','image/webp'];
    if (!allowed.includes(file.type)) { showError(copy.formats); return; }
    currentFile = file;
    fileNameEl.textContent = file.name;
    originalSizeEl.textContent = humanSize(file.size);
    previewObjectUrl = URL.createObjectURL(file);
    filePreview.src = previewObjectUrl;
    fileInfo.style.display = 'block';
    result.style.display = 'none';
  }

  async function compressImage() {
    if (!currentFile) return showError(copy.noFile);
    clearError();

      if (currentFile.size > IMAGE_MAX_FILE) {
        return showError(copy.tooLarge.replace("{size}", String(Math.round(IMAGE_MAX_FILE/1024/1024))));
      }

      compressBtn.disabled = true;
      processing.style.display = 'block';
      result.style.display = 'none';
      try {
        const quality = parseFloat(qualityInput.value);
        const options = { maxSizeMB: 2, useWebWorker: true, initialQuality: quality };
        const compressedFile = await imageCompression(currentFile, options);
        const finalBlob = compressedFile;
        const finalSize = finalBlob.size;
        const originalSize = currentFile.size;

        // revoke previous image URL
        if (currentImageObjectUrl) { try { URL.revokeObjectURL(currentImageObjectUrl); } catch(e){} currentImageObjectUrl = null; }

        const setDownload = (blob, name) => {
          currentImageObjectUrl = URL.createObjectURL(blob);
          downloadLink.href = currentImageObjectUrl;
          downloadLink.download = name;
          const onClick = () => { setTimeout(()=>{ if (currentImageObjectUrl) { try { URL.revokeObjectURL(currentImageObjectUrl); } catch(e){} currentImageObjectUrl = null; } }, 1500); };
          downloadLink.addEventListener('click', onClick, { once: true });
        };

        if (finalSize >= originalSize) {
          processing.style.display = 'none';
          result.style.display = 'block';
          finalSizeEl.textContent = humanSize(finalSize);
          reductionEl.textContent = copy.noReduction;
          setDownload(finalBlob, 'compressed-' + currentFile.name);
          return;
        }
        const reductionPct = Math.round(((originalSize - finalSize) / originalSize) * 100);
        processing.style.display = 'none';
        result.style.display = 'block';
        finalSizeEl.textContent = humanSize(finalSize);
        reductionEl.textContent = `${reductionPct}%`;
        setDownload(finalBlob, 'compressed-' + currentFile.name);
      } catch (err) {
        console.error(err);
        showError(copy.error);
      } finally {
        compressBtn.disabled = false;
        processing.style.display = 'none';
      }
    }

    compressBtn.addEventListener('click', compressImage);
</script>
