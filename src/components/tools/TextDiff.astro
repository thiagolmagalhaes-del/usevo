---
import type { Locale } from "../../data/locales";
const { locale = "en" } = Astro.props as { locale?: Locale };
const copy = locale === "pt-BR" ? { title: "Comparador de texto", original: "Texto original", modified: "Texto modificado", compare: "Comparar", clear: "Limpar" } : locale === "es" ? { title: "Comparador de texto", original: "Texto original", modified: "Texto modificado", compare: "Comparar", clear: "Limpiar" } : { title: "Text Comparator", original: "Original text", modified: "Modified text", compare: "Compare", clear: "Clear" };
---
<div class="tool-card card">
  <h1 style="font-size: 1.5em; margin-block: 0.83em;">{copy.title}</h1>
  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:1; min-width:260px;">
      <label>{copy.original}</label>
      <textarea id="original" rows="10" style="width:100%"></textarea>
    </div>
    <div style="flex:1; min-width:260px;">
      <label>{copy.modified}</label>
      <textarea id="modified" rows="10" style="width:100%"></textarea>
    </div>
  </div>
  <div style="margin-top:12px">
    <button id="compareBtn">{copy.compare}</button>
    <button id="clearBtn">{copy.clear}</button>
  </div>
  <div id="result" style="margin-top:12px"></div>
</div>

<style>
.added { background:#ecfdf3; border-left:4px solid #16a34a; padding:6px; white-space:pre-wrap; }
.removed { background:#fff1f0; border-left:4px solid #dc2626; padding:6px; white-space:pre-wrap; }
.unchanged { background:#f8fafc; padding:6px; white-space:pre-wrap; }
</style>

<script type="module">
  import { diffLines } from 'diff';

  const original = document.getElementById('original');
  const modified = document.getElementById('modified');
  const compareBtn = document.getElementById('compareBtn');
  const clearBtn = document.getElementById('clearBtn');
  const result = document.getElementById('result');

  function safeTextNode(text) {
    return document.createTextNode(text);
  }

  function renderDiff(a, b) {
    result.innerHTML = '';
    const parts = diffLines(a, b);
    parts.forEach(part => {
      const div = document.createElement('div');
      if (part.added) div.className = 'added';
      else if (part.removed) div.className = 'removed';
      else div.className = 'unchanged';
      // Use textContent to avoid XSS
      div.textContent = part.value;
      result.appendChild(div);
    });
  }

  compareBtn.addEventListener('click', () => renderDiff(original.value || '', modified.value || ''));
  clearBtn.addEventListener('click', () => { original.value = ''; modified.value = ''; result.innerHTML = ''; });
</script>
