---
import type { Locale } from "../../data/locales";
const { locale = "pt-BR" } = Astro.props as { locale?: Locale };
const copy = locale === "pt-BR" ? {
  title:"Conversor de imagens", eyebrow:"Ferramentas › Arquivos", intro:"Converta JPG, PNG e WebP neste navegador. Sua imagem não é enviada para um servidor.", upload:"Arraste uma imagem aqui ou clique para selecionar", hint:"Aceita JPG, PNG e WebP. Uma imagem de até 20 MB.", original:"Arquivo original", file:"Nome", format:"Formato", dimensions:"Dimensões", size:"Tamanho", output:"Formato de saída", quality:"Qualidade", pngNote:"PNG preserva a qualidade visual; este formato não usa ajuste de qualidade.", background:"Fundo para JPG", backgroundHelp:"Áreas transparentes serão preenchidas com esta cor.", convert:"Converter imagem", clear:"Limpar", another:"Converter outra imagem", processing:"Processando imagem…", ready:"Imagem pronta para converter.", outputReady:"Imagem convertida com sucesso.", converted:"Arquivo convertido", download:"Baixar imagem", noFile:"Selecione uma imagem antes de converter.", tooLarge:"A imagem deve ter no máximo 20 MB.", invalidFile:"Não foi possível ler esta imagem. Ela pode estar truncada, corrompida ou em formato inválido.", extensionMismatch:"A extensão do arquivo não corresponde ao conteúdo real da imagem.", mimeMismatch:"O tipo informado pelo arquivo não corresponde ao conteúdo real da imagem.", dimensionsTooLarge:"As dimensões excedem o limite seguro de 8.192 px por lado ou 16 megapixels.", readError:"Não foi possível decodificar a imagem.", processingError:"Não foi possível converter a imagem neste navegador.", resultTooLarge:"O resultado excede o limite de 50 MB.", webpUnsupported:"Este navegador não oferece exportação WebP. Escolha JPG ou PNG.", privacyTitle:"Privacidade e limitações", privacy:"O processamento acontece localmente no navegador. A conversão preserva os pixels e as dimensões, mas não preserva metadados, animação, perfil de cores ou profundidade superior a 8 bits.", previewAlt:"Prévia da imagem original", resultPreviewAlt:"Prévia da imagem convertida",
} : locale === "es" ? {
  title:"Convertidor de imágenes", eyebrow:"Herramientas › Archivos", intro:"Convierte JPG, PNG y WebP en este navegador. Tu imagen no se envía a un servidor.", upload:"Arrastra una imagen aquí o haz clic para seleccionarla", hint:"Acepta JPG, PNG y WebP. Una imagen de hasta 20 MB.", original:"Archivo original", file:"Nombre", format:"Formato", dimensions:"Dimensiones", size:"Tamaño", output:"Formato de salida", quality:"Calidad", pngNote:"PNG conserva la calidad visual; este formato no usa ajuste de calidad.", background:"Fondo para JPG", backgroundHelp:"Las áreas transparentes se rellenarán con este color.", convert:"Convertir imagen", clear:"Limpiar", another:"Convertir otra imagen", processing:"Procesando imagen…", ready:"Imagen lista para convertir.", outputReady:"Imagen convertida correctamente.", converted:"Archivo convertido", download:"Descargar imagen", noFile:"Selecciona una imagen antes de convertir.", tooLarge:"La imagen debe tener como máximo 20 MB.", invalidFile:"No se pudo leer esta imagen. Puede estar truncada, dañada o tener un formato inválido.", extensionMismatch:"La extensión del archivo no coincide con el contenido real de la imagen.", mimeMismatch:"El tipo informado por el archivo no coincide con el contenido real de la imagen.", dimensionsTooLarge:"Las dimensiones superan el límite seguro de 8.192 px por lado o 16 megapíxeles.", readError:"No se pudo decodificar la imagen.", processingError:"No se pudo convertir la imagen en este navegador.", resultTooLarge:"El resultado supera el límite de 50 MB.", webpUnsupported:"Este navegador no ofrece exportación WebP. Elige JPG o PNG.", privacyTitle:"Privacidad y limitaciones", privacy:"El procesamiento ocurre localmente en el navegador. La conversión conserva los píxeles y las dimensiones, pero no conserva metadatos, animación, perfil de color ni profundidad superior a 8 bits.", previewAlt:"Vista previa de la imagen original", resultPreviewAlt:"Vista previa de la imagen convertida",
} : {
  title:"Image Converter", eyebrow:"Tools › Files", intro:"Convert JPG, PNG, and WebP in this browser. Your image is not sent to a server.", upload:"Drag an image here or click to select", hint:"Accepts JPG, PNG, and WebP. One image up to 20 MB.", original:"Original file", file:"Name", format:"Format", dimensions:"Dimensions", size:"Size", output:"Output format", quality:"Quality", pngNote:"PNG preserves visual quality; this format does not use a quality setting.", background:"JPG background", backgroundHelp:"Transparent areas will be filled with this color.", convert:"Convert image", clear:"Clear", another:"Convert another image", processing:"Processing image…", ready:"Image ready to convert.", outputReady:"Image converted successfully.", converted:"Converted file", download:"Download image", noFile:"Select an image before converting.", tooLarge:"The image must be 20 MB or smaller.", invalidFile:"This image could not be read. It may be truncated, corrupted, or invalid.", extensionMismatch:"The file extension does not match the actual image content.", mimeMismatch:"The file-reported type does not match the actual image content.", dimensionsTooLarge:"Dimensions exceed the safe limit of 8,192 px per side or 16 megapixels.", readError:"The image could not be decoded.", processingError:"The image could not be converted in this browser.", resultTooLarge:"The result exceeds the 50 MB limit.", webpUnsupported:"This browser does not provide WebP export. Choose JPG or PNG.", privacyTitle:"Privacy and limitations", privacy:"Processing happens locally in the browser. Conversion preserves pixels and dimensions, but not metadata, animation, color profile, or color depth above 8-bit.", previewAlt:"Original image preview", resultPreviewAlt:"Converted image preview",
};
---
<main class="image-converter"><div class="container"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="intro">{copy.intro}</p>
  <form id="imageConverterForm" novalidate>
    <label id="imageConverterDropArea" class="drop-area" for="imageConverterInput"><strong>{copy.upload}</strong><span id="imageConverterHint">{copy.hint}</span></label>
    <input id="imageConverterInput" class="file-input" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" aria-describedby="imageConverterHint" />
    <section id="imageConverterInfo" class="card image-info" hidden aria-labelledby="imageConverterOriginalTitle"><h2 id="imageConverterOriginalTitle">{copy.original}</h2><img id="imageConverterPreview" class="preview" alt={copy.previewAlt} /><dl><div><dt>{copy.file}</dt><dd id="imageConverterName"></dd></div><div><dt>{copy.format}</dt><dd id="imageConverterSourceFormat"></dd></div><div><dt>{copy.dimensions}</dt><dd id="imageConverterSourceDimensions"></dd></div><div><dt>{copy.size}</dt><dd id="imageConverterSourceSize"></dd></div></dl></section>
    <section id="imageConverterControls" class="card controls" hidden aria-labelledby="imageConverterControlsTitle"><h2 id="imageConverterControlsTitle">{copy.output}</h2><label for="imageConverterOutput">{copy.output}</label><select id="imageConverterOutput"></select><div id="imageConverterQualityRow"><label for="imageConverterQuality">{copy.quality}</label><input id="imageConverterQuality" type="range" min="0.1" max="1" step="0.01" value="0.92" /></div><p id="imageConverterPngNote" class="note">{copy.pngNote}</p><div id="imageConverterBackgroundRow"><label for="imageConverterBackground">{copy.background}</label><div class="color-picker"><input id="imageConverterBackground" class="color-input" type="color" value="#ffffff" aria-describedby="imageConverterBackgroundHelp imageConverterBackgroundValue" /><output id="imageConverterBackgroundValue" class="color-value" aria-live="polite">#FFFFFF</output></div><p id="imageConverterBackgroundHelp" class="background-help">{copy.backgroundHelp}</p></div><div class="actions"><button id="imageConverterConvert" class="button primary" type="button">{copy.convert}</button><button id="imageConverterClear" class="button secondary" type="button">{copy.clear}</button></div></section>
  </form>
  <p id="imageConverterStatus" class="status" aria-live="polite"></p><p id="imageConverterError" class="error" role="alert" hidden></p>
  <section id="imageConverterResult" class="card result" hidden aria-live="polite" aria-labelledby="imageConverterResultTitle"><h2 id="imageConverterResultTitle">{copy.converted}</h2><img id="imageConverterResultPreview" class="preview" alt={copy.resultPreviewAlt} /><dl><div><dt>{copy.file}</dt><dd id="imageConverterResultName"></dd></div><div><dt>{copy.format}</dt><dd id="imageConverterResultFormat"></dd></div><div><dt>{copy.dimensions}</dt><dd id="imageConverterResultDimensions"></dd></div><div><dt>{copy.size}</dt><dd id="imageConverterResultSize"></dd></div></dl><a id="imageConverterDownload" class="button primary" download>{copy.download}</a><button id="imageConverterAnother" class="button secondary another" type="button" hidden>{copy.another}</button></section>
  <section class="card explanation" aria-labelledby="imageConverterPrivacyTitle"><h2 id="imageConverterPrivacyTitle">{copy.privacyTitle}</h2><p>{copy.privacy}</p></section>
</div></main>
<style>.image-converter{background:#f8f9fc;min-height:100%;padding:48px 20px 80px}.container{margin:0 auto;max-width:780px}.eyebrow{color:#315bdc;font-size:14px;font-weight:700;margin:0 0 8px}h1{font-size:clamp(32px,5vw,46px);line-height:1.1;margin:0}.intro{color:#687386;font-size:18px;line-height:1.55;margin:14px 0 30px}.card{background:#fff;border:1px solid #e5e8ef;border-radius:18px;box-shadow:0 8px 30px rgba(20,30,50,.06);margin-top:18px;padding:24px}.drop-area{align-items:center;background:#fff;border:2px dashed #aebce0;border-radius:18px;color:#1c326b;cursor:pointer;display:flex;flex-direction:column;gap:8px;justify-content:center;min-height:146px;padding:22px;text-align:center;user-select:none;-webkit-user-select:none}.drop-area[data-dragging=true]{background:#eef2ff;border-color:#315bdc}.drop-area span,.note,.background-help{color:#687386;font-size:14px}.file-input{height:1px;opacity:0;overflow:hidden;position:absolute;width:1px}.image-info{display:grid;gap:18px;grid-template-columns:minmax(160px,240px) 1fr}.preview{background:#f3f5f9;border-radius:12px;display:block;max-height:300px;max-width:100%;object-fit:contain;width:100%}h2{font-size:20px;margin:0 0 16px}dl{display:grid;gap:12px;margin:0}dl div{display:flex;gap:16px;justify-content:space-between}dt{color:#5d687a}dd{font-weight:700;margin:0;overflow-wrap:anywhere;text-align:right}.controls label{display:block;font-weight:600;margin:14px 0 7px}.controls input,.controls select{border:1px solid #dfe3ea;border-radius:10px;box-sizing:border-box;color:#172033;font:inherit;padding:12px;width:100%}.color-picker{align-items:center;display:flex;gap:12px}.controls .color-input{cursor:pointer;height:46px;padding:3px;width:58px}.color-value{background:#f3f5f9;border:1px solid #dfe3ea;border-radius:8px;color:#172033;font-family:ui-monospace,monospace;font-weight:700;padding:11px 12px}.background-help{margin:8px 0 0}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.button{align-items:center;border:0;border-radius:10px;box-sizing:border-box;cursor:pointer;display:inline-flex;font:inherit;font-weight:700;justify-content:center;min-height:44px;padding:11px 16px;text-decoration:none}.primary{background:#315bdc;color:#fff}.secondary{background:#eef2ff;color:#234cbd}.actions .button{flex:1 1 180px}.status{color:#315bdc;font-weight:600;min-height:1.5em;margin:16px 0 0}.error{background:#fff1f0;border-radius:10px;color:#8a280d;margin:16px 0 0;padding:12px}.result .button{margin-top:18px;width:100%}.another{width:100%}.explanation{color:#536176;line-height:1.55}button:focus-visible,.button:focus-visible,.drop-area:focus-within,select:focus,input:focus{outline:2px solid #315bdc;outline-offset:2px}@media(max-width:620px){.image-converter{padding:32px 16px 64px}.card{padding:20px}.image-info{grid-template-columns:1fr}dl div{align-items:flex-start;flex-direction:column;gap:3px}dd{text-align:left}}</style>
<script id="imageConverterCopy" type="application/json" set:html={JSON.stringify(copy)}></script><script>import { initializeImageConverter } from "../../lib/image-converter-client"; const rawCopy=document.getElementById("imageConverterCopy")?.textContent; if(rawCopy) void initializeImageConverter(document,JSON.parse(rawCopy));</script>
