---
import type { Locale } from "../../data/locales";
const { locale = "en" } = Astro.props as { locale?: Locale };
const copy = locale === "pt-BR" ? { title: "Formatador SQL", dialect: "Dialeto (opcional)", standard: "SQL padrão", format: "Formatar SQL", copy: "Copiar", clear: "Limpar" } : locale === "es" ? { title: "Formateador SQL", dialect: "Dialecto (opcional)", standard: "SQL estándar", format: "Formatear SQL", copy: "Copiar", clear: "Limpiar" } : { title: "SQL Formatter", dialect: "Dialect (optional)", standard: "Standard SQL", format: "Format SQL", copy: "Copy", clear: "Clear" };
---
<div class="tool-card card">
  <h2>{copy.title}</h2>
  <label>SQL</label>
  <textarea id="sqlInput" rows="12" style="width:100%"></textarea>
  <div style="margin-top:8px">
    <label for="dialect">{copy.dialect}</label>
    <select id="dialect">
      <option value="sql">{copy.standard}</option>
      <option value="postgresql">PostgreSQL</option>
      <option value="mysql">MySQL</option>
      <option value="sqlite">SQLite</option>
    </select>
  </div>
  <div style="margin-top:12px">
    <button id="formatBtn">{copy.format}</button>
    <button id="copyBtn">{copy.copy}</button>
    <button id="clearBtn">{copy.clear}</button>
  </div>
  <div id="result" style="margin-top:12px"><pre id="formatted" style="white-space:pre-wrap"></pre></div>
  <div id="error" class="error" style="display:none"></div>
</div>

<style>
.error { color:#7a1f00; background:#fff1f0; padding:8px; border-radius:8px; margin-top:8px; }
</style>

<script type="module">
  import './SqlFormatter.client.js';
</script>
