---
import { getToolLocaleRoute } from "../../data/locale-routes";
import type { Locale } from "../../data/locales";
import { getCategoryTranslation } from "../../data/i18n";

interface Ferramenta {
  nome: string;
  descricao: string;
  categoria: string;
  categoryKey: string;
  icone: string;
  url: string;
  localeSlugs?: Partial<Record<Locale, string>>;
  translations?: Partial<Record<Locale, { title: string; description: string }>>;
}

const { ferramenta, locale = "pt-BR" } = Astro.props as {
  ferramenta: Ferramenta;
  locale?: Locale;
};

const localizedTitle =
  locale === "en"
    ? ferramenta.translations?.en?.title ?? ferramenta.nome
    : locale === "es"
      ? ferramenta.translations?.es?.title ?? ferramenta.nome
      : ferramenta.nome;

const localizedDescription =
  locale === "en"
    ? ferramenta.translations?.en?.description ?? ferramenta.descricao
    : locale === "es"
      ? ferramenta.translations?.es?.description ?? ferramenta.descricao
      : ferramenta.descricao;

const localizedCategory = getCategoryTranslation(ferramenta.categoryKey, locale);

const resolvedHref = getToolLocaleRoute(
  ferramenta as any,
  locale,
) ?? ferramenta.url;
---

<a
  href={resolvedHref}
  class="tool-card"
  data-name={localizedTitle.toLowerCase()}
  data-category={localizedCategory.toLowerCase()}
>
  <div class="tool-icon">{ferramenta.icone}</div>

  <span class="category">{localizedCategory}</span>

  <h3>{localizedTitle}</h3>

  <p>{localizedDescription}</p>
</a>

<style>
  .tool-card {
    min-height: 230px;
    padding: 24px;
    border: 1px solid #e7e9ee;
    border-radius: 16px;
    background: #ffffff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .tool-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
  }

  .tool-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #eef2ff;
    color: #315bea;
    font-size: 21px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .category {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #315bea;
  }

  .tool-card h3 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  .tool-card p {
    margin: 0;
    color: #667085;
    line-height: 1.5;
    font-size: 14px;
  }
</style>
