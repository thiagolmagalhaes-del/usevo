---
import ToolGrid from "./ToolGrid.astro";
import { ferramentas } from "../../data/ferramentas";
import { getCategoryTranslation, getTranslations } from "../../data/i18n";
import type { Locale } from "../../data/locales";

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
const categoryFilters = Array.from(new Set(ferramentas.map((tool) => tool.categoryKey))).map((key) => getCategoryTranslation(key, locale));
const copy = locale === "pt-BR"
  ? { intro: "Explore ferramentas para arquivos, imagens, texto, cálculos e muito mais.", browse: "Explorar ferramentas", search: "Buscar ferramentas", placeholder: "Pesquise por nome, descrição ou categoria…", filter: "Filtrar por categoria", all: "Todas", available: "ferramentas disponíveis", found: "encontrada", foundPlural: "encontradas" }
  : locale === "es"
    ? { intro: "Explora herramientas para archivos, imágenes, texto, cálculos y mucho más.", browse: "Explorar herramientas", search: "Buscar herramientas", placeholder: "Busca por nombre, descripción o categoría…", filter: "Filtrar por categoría", all: "Todas", available: "herramientas disponibles", found: "encontrada", foundPlural: "encontradas" }
    : { intro: "Browse tools for files, images, text, calculations, and more.", browse: "Browse tools", search: "Search tools", placeholder: "Search by name, description, or category…", filter: "Filter by category", all: "All", available: "tools available", found: "tool found", foundPlural: "tools found" };
---
<style>
  .page-shell{width:min(1180px,calc(100% - 40px));margin:0 auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.catalog-header{padding:44px 0 22px;text-align:center}.catalog-header h1{margin:0 auto 10px;font-size:42px;letter-spacing:-1px;font-weight:800}.page-intro{max-width:720px;margin:0 auto;color:#667085;font-size:17px;line-height:1.6}.catalog-browser{min-width:0;padding:0 0 72px}.catalog-controls{margin:0 0 22px;padding:18px;border:1px solid #e7e9ee;border-radius:14px;background:#fff}.catalog-search label,.filter-label{display:block;margin-bottom:8px;color:#344054;font-size:14px;font-weight:700}.filter-label{flex-basis:100%}.catalog-search input{width:100%;min-height:44px;padding:10px 12px;border:1px solid #cfd6e4;border-radius:8px;color:#172033;font:inherit}.catalog-search input:focus-visible,.category-filter:focus-visible,.catalog-browser :global(.tool-card:focus-visible){outline:3px solid #93c5fd;outline-offset:3px}.category-filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.category-filter{min-height:44px;padding:10px 14px;border:1px solid #d9dee8;border-radius:999px;background:#fff;color:#344054;font:inherit;font-size:14px;font-weight:700;cursor:pointer;touch-action:manipulation}.category-filter:hover,.category-filter[aria-pressed="true"]{border-color:#315bea;background:#eef2ff;color:#1d4ed8}.catalog-results{min-height:1.5em;margin:14px 0 0;color:#667085;font-size:14px}.catalog-browser :global(.tools-grid){gap:14px}.catalog-browser :global(.tool-card){min-width:0;overflow-wrap:anywhere}.catalog-browser :global(.tool-card[hidden]){display:none}@media(max-width:650px){.page-shell{width:min(100% - 28px,1180px)}.catalog-header{padding:30px 0 16px}.catalog-header h1{margin-bottom:8px;font-size:32px}.page-intro{font-size:16px}.catalog-browser{padding-bottom:52px}.catalog-controls{margin-bottom:16px;padding:14px}.category-filters{gap:6px;margin-top:12px}.category-filter{padding:8px 12px}.catalog-browser :global(.tools-grid){grid-template-columns:1fr;gap:10px}.catalog-browser :global(.tool-card){min-height:auto;height:auto;padding:14px;border-radius:12px}.catalog-browser :global(.tool-icon){width:36px;height:36px;margin-bottom:10px;border-radius:9px;font-size:18px}.catalog-browser :global(.category){margin-bottom:5px}.catalog-browser :global(.tool-card h3){margin-bottom:6px;font-size:16px;line-height:1.25}.catalog-browser :global(.tool-card p){font-size:13px;line-height:1.4}}@media(min-width:380px) and (max-width:650px){.catalog-browser :global(.tools-grid){grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<main><section class="catalog-header"><div class="page-shell"><h1>{t.allTools}</h1><p class="page-intro">{copy.intro}</p></div></section><section class="catalog-browser" aria-labelledby="tools-catalog-title" data-available={copy.available} data-found={copy.found} data-found-plural={copy.foundPlural}><div class="page-shell"><h2 id="tools-catalog-title" class="sr-only">{copy.browse}</h2><div class="catalog-controls"><div class="catalog-search"><label for="toolSearch">{copy.search}</label><input id="toolSearch" name="tool-search" type="search" autocomplete="off" placeholder={copy.placeholder} /></div><div class="category-filters" role="group" aria-label={copy.filter}><span class="filter-label">{copy.filter}</span><button class="category-filter" type="button" data-category-filter="all" aria-pressed="true">{copy.all}</button>{categoryFilters.map((category) => <button class="category-filter" type="button" data-category-filter={category} aria-pressed="false">{category}</button>)}</div><p id="toolResults" class="catalog-results" role="status" aria-live="polite">{ferramentas.length} {copy.available}.</p></div><ToolGrid items={ferramentas} locale={locale} /></div></section></main>
<script>
  const matchesCatalogItem=(item:{text:string;category:string},query:string,selectedCategory:string)=>{const normalize=(value:string)=>value.trim().toLocaleLowerCase();return(normalize(selectedCategory)==="all"||normalize(item.category)===normalize(selectedCategory))&&normalize(item.text).includes(normalize(query))};
  const catalog=document.querySelector(".catalog-browser");
  if(catalog instanceof HTMLElement){const available=catalog.dataset.available??"tools available",found=catalog.dataset.found??"tool found",foundPlural=catalog.dataset.foundPlural??"tools found",search=catalog.querySelector<HTMLInputElement>("#toolSearch"),results=catalog.querySelector<HTMLElement>("#toolResults"),cards=Array.from(catalog.querySelectorAll<HTMLElement>(".tool-card")),grid=catalog.querySelector<HTMLElement>(".tools-grid"),filters=Array.from(catalog.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));let selectedCategory="all";const updateCatalog=()=>{const visibleCards=cards.filter((card)=>{const visible=matchesCatalogItem({text:card.textContent??"",category:card.dataset.category??""},search?.value??"",selectedCategory);card.hidden=!visible;return visible});if(results)results.textContent=visibleCards.length===cards.length?`${visibleCards.length} ${available}.`:`${visibleCards.length} ${visibleCards.length===1?found:foundPlural}.`;return visibleCards};search?.addEventListener("input",updateCatalog);search?.addEventListener("keydown",(event)=>{if(event.key!=="Enter")return;event.preventDefault();const visibleCards=updateCatalog();grid?.scrollIntoView({behavior:"smooth",block:"start"});if(visibleCards.length===1&&visibleCards[0] instanceof HTMLAnchorElement){window.location.assign(visibleCards[0].href);return}const firstVisibleCard=visibleCards[0];firstVisibleCard?.focus({preventScroll:true})});filters.forEach((filter)=>filter.addEventListener("click",()=>{selectedCategory=filter.dataset.categoryFilter??"all";filters.forEach((button)=>button.setAttribute("aria-pressed",String(button===filter)));updateCatalog()}));updateCatalog()}
</script>
