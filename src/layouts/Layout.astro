---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { resolveLocale, type Locale } from "../data/locales";
import { getCanonicalUrl, getToolBreadcrumb } from "../data/locale-routes";
import {
  createBreadcrumbListJsonLd,
  serializeJsonLd,
  type WebsiteJsonLd,
} from "../data/structured-data";

const {
  title = "USEVO TOOLS",
  description = "Simple, fast, and useful online tools for everyday tasks.",
  locale,
  canonical,
  alternateUrls,
  robots = "index, follow",
  structuredData,
} = Astro.props as {
  title?: string;
  description?: string;
  locale?: string | null;
  canonical?: string;
  alternateUrls?: Partial<Record<Locale, string>>;
  robots?: string;
  structuredData?: WebsiteJsonLd;
};

const resolvedLocale = resolveLocale(locale ?? "en") as Locale;
const canonicalUrl = getCanonicalUrl(canonical ?? Astro.url.pathname);
const pageTitle = title.includes("USEVO TOOLS") ? title : `${title} | USEVO TOOLS`;
const alternateEntries = Object.entries(alternateUrls ?? {}) as [Locale, string][];
const breadcrumb = getToolBreadcrumb(Astro.url.pathname, resolvedLocale);
const structuredDataItems = [
  ...(structuredData ? [structuredData] : []),
  ...(breadcrumb ? [createBreadcrumbListJsonLd(breadcrumb.items)] : []),
];
const serializedStructuredData = structuredDataItems.map(serializeJsonLd);
---

<!doctype html>
<html lang={resolvedLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-adsense-account" content="ca-pub-8421803734884795" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {alternateEntries.map(([lang, href]) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="canonical" href={canonicalUrl} />
    {serializedStructuredData.map((data) => <script type="application/ld+json" set:html={data} />)}
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader locale={resolvedLocale} />
    {breadcrumb && <Breadcrumbs breadcrumb={breadcrumb} />}
    <slot />
    <SiteFooter locale={resolvedLocale} />
    <AnalyticsConsent locale={resolvedLocale} />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #172033;
    background: #ffffff;
  }

  a {
    text-decoration: none;
    color: inherit;
  }
</style>
