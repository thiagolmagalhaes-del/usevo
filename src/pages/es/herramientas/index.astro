---
import Layout from "../../../layouts/Layout.astro";
import CatalogBrowser from "../../../components/tool/CatalogBrowser.astro";
import { getTranslations } from "../../../data/i18n";
import { getSiteAlternates } from "../../../data/locale-routes";

const t = getTranslations("es");
const canonical = "https://usevo.tools/es/herramientas/";
const alternateUrls = getSiteAlternates("/es/herramientas/");
---

<Layout title={t.allTools} description="Explora todas las herramientas de USEVO TOOLS en español." locale="es" canonical={canonical} alternateUrls={alternateUrls}>
  <CatalogBrowser locale="es" />
</Layout>
