---
import Base64Page from "../../ferramentas/base64.astro";
import CalculadoraPage from "../../ferramentas/calculadora.astro";
import CalculadoraDeDatasPage from "../../ferramentas/calculadora-de-datas.astro";
import CalculadoraDeIdadePage from "../../ferramentas/calculadora-de-idade.astro";
import CalculadoraDePorcentagemPage from "../../ferramentas/calculadora-de-porcentagem.astro";
import CalculadoraCltPjPage from "../../ferramentas/calculadora-clt-pj.astro";
import ComparadorDeTextoPage from "../../ferramentas/comparador-de-texto.astro";
import ComprimirImagemPage from "../../ferramentas/comprimir-imagem.astro";
import RedimensionarImagemPage from "../../ferramentas/redimensionar-imagem.astro";
import ComprimirPdfPage from "../../ferramentas/comprimir-pdf.astro";
import ContadorDePalavrasPage from "../../ferramentas/contador-de-palavras.astro";
import CaseConverterPage from "../../ferramentas/conversor-maiusculas-minusculas.astro";
import FontGeneratorPage from "../../ferramentas/gerador-de-letras-diferentes.astro";
import ConversorDeMoedasPage from "../../ferramentas/conversor-de-moedas.astro";
import ConversorDeUnidadesPage from "../../ferramentas/conversor-de-unidades.astro";
import FormatadorDeJsonPage from "../../ferramentas/formatador-de-json.astro";
import FormatadorSqlPage from "../../ferramentas/formatador-sql/index.astro";
import GeradorDeQrCodePage from "../../ferramentas/gerador-de-qr-code.astro";
import BarcodeGeneratorPage from "../../ferramentas/gerador-de-codigo-de-barras.astro";
import WheelOfNamesPage from "../../ferramentas/roleta-de-nomes.astro";
import LeitorDeQrCodePage from "../../ferramentas/leitor-de-qr-code.astro";
import GeradorDeSenhasPage from "../../ferramentas/gerador-de-senhas.astro";
import JpgParaPdfPage from "../../ferramentas/jpg-para-pdf.astro";
import PdfToJpgPage from "../../ferramentas/pdf-para-jpg.astro";
import ImageConverterPage from "../../ferramentas/converter-imagem.astro";
import JsonInspectorPage from "../../ferramentas/json-inspector.astro";
import JuntarPdfPage from "../../ferramentas/juntar-pdf.astro";
import DividirPdfPage from "../../ferramentas/dividir-pdf.astro";
import UrlEncoderDecoderPage from "../../ferramentas/url-encoder-decoder.astro";
import UuidGeneratorPage from "../../ferramentas/uuid-generator.astro";
import { ferramentas, getFerramentaTranslation } from "../../../data/ferramentas";
import { resolveToolByLocaleSlug } from "../../../data/locale-routes";

export function getStaticPaths() {
  return ferramentas.map((ferramenta) => ({
    params: { slug: ferramenta.localeSlugs.es },
  }));
}

const { slug } = Astro.params;
const ferramenta = resolveToolByLocaleSlug(slug, "es");
if (!ferramenta) {
  throw new Error(`Tool not found for ES slug: ${slug ?? "(empty)"}`);
}

const toolMeta = getFerramentaTranslation(ferramenta, "es");
const toolPageMap = {
  "calculadora-de-porcentagem": CalculadoraDePorcentagemPage,
  calculadora: CalculadoraPage,
  "calculadora-de-datas": CalculadoraDeDatasPage,
  "calculadora-de-idade": CalculadoraDeIdadePage,
  "conversor-de-unidades": ConversorDeUnidadesPage,
  "conversor-de-moedas": ConversorDeMoedasPage,
  "contador-de-palavras": ContadorDePalavrasPage,
  "conversor-maiusculas-minusculas": CaseConverterPage,
  "gerador-de-letras-diferentes": FontGeneratorPage,
  "gerador-de-senhas": GeradorDeSenhasPage,
  "gerador-de-qr-code": GeradorDeQrCodePage,
  "gerador-de-codigo-de-barras": BarcodeGeneratorPage,
  "roleta-de-nomes": WheelOfNamesPage,
  "leitor-de-qr-code": LeitorDeQrCodePage,
  "jpg-para-pdf": JpgParaPdfPage,
  "pdf-para-jpg": PdfToJpgPage,
  "converter-imagem": ImageConverterPage,
  base64: Base64Page,
  "formatador-de-json": FormatadorDeJsonPage,
  "json-inspector": JsonInspectorPage,
  "url-encoder-decoder": UrlEncoderDecoderPage,
  "uuid-generator": UuidGeneratorPage,
  "calculadora-clt-pj": CalculadoraCltPjPage,
  "comprimir-pdf": ComprimirPdfPage,
  "juntar-pdf": JuntarPdfPage,
  "dividir-pdf": DividirPdfPage,
  "comprimir-imagem": ComprimirImagemPage,
  "redimensionar-imagem": RedimensionarImagemPage,
  "comparador-de-texto": ComparadorDeTextoPage,
  "formatador-sql": FormatadorSqlPage,
} as const;
const PageComponent = toolPageMap[ferramenta.id as keyof typeof toolPageMap];
---

{PageComponent ? <PageComponent locale="es" /> : <main><h1>{toolMeta.title}</h1></main>}
