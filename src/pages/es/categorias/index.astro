---
import Layout from "../../../layouts/Layout.astro";
import { ferramentas } from "../../../data/ferramentas";
import { getTranslations, getCategoryTranslation } from "../../../data/i18n";
import { getSiteAlternates } from "../../../data/locale-routes";

const t = getTranslations("es");
const categorias = new Map<string, typeof ferramentas>();
for (const ferramenta of ferramentas) {
  const current = categorias.get(ferramenta.categoryKey) ?? [];
  current.push(ferramenta);
  categorias.set(ferramenta.categoryKey, current);
}
const canonical = "https://usevo.tools/es/categorias/";
const alternateUrls = getSiteAlternates("/es/categorias/");
const getToolHref = (ferramenta: (typeof ferramentas)[number]) => `/es/herramientas/${ferramenta.localeSlugs.es}/`;
---

<Layout title={t.categories} description="Explora USEVO TOOLS por categorías." locale="es" canonical={canonical} alternateUrls={alternateUrls}>
  <main>
    <section style="padding: 60px 0 40px; text-align:center;">
      <div style="width:min(1180px, calc(100% - 40px)); margin:0 auto;">
        <h1 style="margin:0 auto 15px;font-size:42px;letter-spacing:-1px;font-weight:800;">{t.categories}</h1>
      </div>
    </section>
    <section style="padding:40px 0 100px;">
      <div style="width:min(1180px, calc(100% - 40px)); margin:0 auto;display:grid;grid-template-columns:repeat(3, 1fr);gap:24px;">
        {Array.from(categorias.entries()).map(([categoria, itens]) => (
          <div style="padding:32px;border:1px solid #e7e9ee;border-radius:16px;background:#fff;">
            <h2 style="margin:0 0 8px;font-size:22px;">{getCategoryTranslation(categoria, "es")}</h2>
            <ul style="list-style:none;padding:0;margin:0;">
              {itens.map((ferramenta) => (
                <li style="margin-bottom:12px;"><a href={getToolHref(ferramenta)} style="display:block;padding:12px;border-radius:8px;background:#f8fafc;color:#315bea;font-size:14px;font-weight:600;">{ferramenta.translations.es?.title ?? ferramenta.nome}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
