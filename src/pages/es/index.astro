---
import Layout from "../../layouts/Layout.astro";
import ToolGrid from "../../components/tool/ToolGrid.astro";
import { ferramentas } from "../../data/ferramentas";
import { getTranslations } from "../../data/i18n";
import { getSiteAlternates } from "../../data/locale-routes";

const t = getTranslations("es");
const canonical = "https://thipatools.com/es/";
const alternateUrls = getSiteAlternates("/es/");
---

<Layout title={t.exploreTools} description="Herramientas online rápidas y útiles para tareas cotidianas." locale="es" canonical={canonical} alternateUrls={alternateUrls}>
  <main>
    <section style="padding: 100px 0 80px; text-align: center;">
      <div style="width: min(1180px, calc(100% - 40px)); margin: 0 auto;">
        <span style="display:inline-block;margin-bottom:22px;font-size:14px;font-weight:700;color:#315bea;">THIPA TOOLS</span>
        <h1 style="margin:0 auto;max-width:800px;font-size:clamp(48px,7vw,76px);line-height:0.98;letter-spacing:-4px;font-weight:800;">Herramientas prácticas para <span style="color:#315bea;">tu día a día</span></h1>
        <p style="max-width:650px;margin:28px auto 34px;color:#667085;font-size:18px;line-height:1.6;">Utilidades online rápidas para calcular, convertir, formatear, generar y agilizar tareas diarias.</p>
      </div>
    </section>

    <section style="padding:30px 0 100px;">
      <div style="width: min(1180px, calc(100% - 40px)); margin: 0 auto;">
        <ToolGrid items={ferramentas} />
      </div>
    </section>
  </main>
</Layout>
