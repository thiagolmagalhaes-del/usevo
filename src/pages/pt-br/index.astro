---
import Layout from "../../layouts/Layout.astro";
import ToolGrid from "../../components/tool/ToolGrid.astro";
import { ferramentas } from "../../data/ferramentas";
import { getTranslations } from "../../data/i18n";
import { getSiteAlternates } from "../../data/locale-routes";

const t = getTranslations("pt-BR");
const alternateUrls = getSiteAlternates("/pt-br/");
---

<Layout
  title="USEVO TOOLS — Ferramentas online"
  description="Ferramentas online simples, rápidas e úteis para tarefas do dia a dia."
  locale="pt-BR"
  canonical="https://usevo.tools/pt-br/"
  alternateUrls={alternateUrls}
>
  <style>
    .container { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
    .hero { padding: 105px 0 80px; text-align: center; }
    .eyebrow { display: inline-block; margin-bottom: 22px; color: #315bea; font-size: 14px; font-weight: 700; }
    h1 { max-width: 800px; margin: 0 auto; font-size: clamp(48px, 7vw, 76px); font-weight: 800; letter-spacing: -4px; line-height: .98; }
    h1 span { color: #315bea; }
    .hero-text { max-width: 650px; margin: 28px auto 34px; color: #667085; font-size: 18px; line-height: 1.6; }
    .search { display: flex; max-width: 620px; margin: 0 auto; padding: 6px; border: 1px solid #e2e5ea; border-radius: 12px; background: #fff; box-shadow: 0 8px 30px rgba(0, 0, 0, .06); }
    .search input { flex: 1; min-width: 0; padding: 15px; border: 0; outline: 0; font-size: 16px; }
    .search button { padding: 0 25px; border: 0; border-radius: 8px; background: #315bea; color: #fff; cursor: pointer; font-weight: 700; }
    .tools-section { padding: 30px 0 100px; }
    .section-heading { margin-bottom: 35px; }
    .section-heading h2 { margin: 0 0 8px; font-size: 32px; letter-spacing: -1px; }
    .section-heading p { margin: 0; color: #6b7280; }
    .explore { margin-top: 35px; text-align: center; }
    .explore a { display: inline-block; padding: 15px 25px; border-radius: 9px; background: #172033; color: #fff; font-weight: 700; }
    @media (max-width: 650px) {
      .container { width: min(100% - 28px, 1180px); }
      .hero { padding: 70px 0 55px; }
      h1 { font-size: 48px; letter-spacing: -2px; }
      .search { flex-direction: column; gap: 6px; }
      .search button { min-height: 48px; }
    }
  </style>

  <main>
    <section class="hero">
      <div class="container">
        <div class="eyebrow">✦ {t.freeOnlineTools}</div>
        <h1>Faça mais.<br /><span>Sem complicação.</span></h1>
        <p class="hero-text">A USEVO TOOLS reúne ferramentas simples, rápidas e úteis para transformar tarefas do dia a dia em poucos cliques.</p>
        <form class="search" id="searchForm">
          <input id="searchInput" type="text" placeholder="O que você precisa fazer?" autocomplete="off" />
          <button type="submit">{t.search}</button>
        </form>
      </div>
    </section>

    <section class="tools-section" id="tools">
      <div class="container">
        <div class="section-heading">
          <h2>{t.popularTools}</h2>
          <p>Escolha uma ferramenta e resolva sua tarefa rapidamente.</p>
        </div>
        <ToolGrid items={ferramentas} locale="pt-BR" />
        <div class="explore"><a href="/categorias/">{t.allTools}</a></div>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById("searchForm");
    const input = document.getElementById("searchInput");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const termo = input.value.trim().toLowerCase();
      if (!termo) {
        window.location.href = "#tools";
        return;
      }

      const cards = document.querySelectorAll(".tool-card");
      let encontrou = false;
      cards.forEach((card) => {
        const nome = card.getAttribute("data-name") || "";
        const categoria = card.getAttribute("data-category") || "";
        const corresponde = nome.includes(termo) || categoria.includes(termo);
        card.style.display = corresponde ? "block" : "none";
        if (corresponde) encontrou = true;
      });

      document.getElementById("tools")?.scrollIntoView({ behavior: "smooth" });
      if (!encontrou) alert("Nenhuma ferramenta encontrada.");
    });
  </script>
</Layout>
