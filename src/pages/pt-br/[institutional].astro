---
import InstitutionalPage from "../../components/InstitutionalPage.astro";
import Layout from "../../layouts/Layout.astro";
import { getInstitutionalAlternates, getInstitutionalContent, institutionalKeys, institutionalRoutes, type InstitutionalKey } from "../../data/institutional-content";
export const getStaticPaths = () => institutionalKeys.map((key) => ({ params: { institutional: institutionalRoutes[key]["pt-BR"].split("/").pop()! }, props: { key } }));
const { key } = Astro.props as { key: InstitutionalKey };
const content = getInstitutionalContent(key, "pt-BR");
---
<Layout title={content.title} description={content.description} canonical={institutionalRoutes[key]["pt-BR"]} alternateUrls={getInstitutionalAlternates(key)} locale="pt-BR"><InstitutionalPage content={content} /></Layout>
