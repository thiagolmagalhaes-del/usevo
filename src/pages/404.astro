---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — USEVO TOOLS" description="The page you were looking for doesn't exist on USEVO TOOLS. Head back home or explore the available tools." robots="noindex, follow">
  <main style="max-width: 760px; margin: 80px auto 120px; padding: 0 24px; text-align: center;">
    <p style="margin: 0 0 18px; font-size: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #315bea;">404</p>
    <h1 style="margin: 0 0 18px; font-size: clamp(36px, 6vw, 64px); line-height: 1.05; letter-spacing: -2px; color: #172033;">Page not found</h1>
    <p style="margin: 0 0 28px; color: #667085; font-size: 18px; line-height: 1.6;">
      The URL you visited doesn't exist or has been moved. Head back to the homepage or explore the available tools.
    </p>
    <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
      <a href="/" style="display: inline-block; padding: 14px 22px; border-radius: 10px; background: #172033; color: #ffffff; font-weight: 700; text-decoration: none;">Go to homepage</a>
      <a href="/ferramentas" style="display: inline-block; padding: 14px 22px; border-radius: 10px; background: #eef2ff; color: #172033; font-weight: 700; text-decoration: none;">View tools</a>
    </div>
  </main>
</Layout>
