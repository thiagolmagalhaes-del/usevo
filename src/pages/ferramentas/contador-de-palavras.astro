---
import Layout from "../../layouts/Layout.astro";
import ToolEditorialContent from "../../components/tools/ToolEditorialContent.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getEditorialRelatedTools, getToolEditorialContent } from "../../data/tool-editorial-content";
import { getSiteAlternates } from "../../data/locale-routes";
import { getToolUi } from "../../data/i18n";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";
const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);
const toolUi = getToolUi(locale);
const ui = toolUi.tools["contador-de-palavras"];
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/contador-de-palavras");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const editorialContent = getToolEditorialContent(ferramenta?.id, locale);
const editorialRelatedTools = getEditorialRelatedTools(editorialContent, locale);
const title = toolMeta.seoTitle;
const description = toolMeta.seoDescription;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---



<Layout title={title} description={description} canonical={canonicalUrl} alternateUrls={alternateUrls} locale={locale}>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      color: #172033;
    }

    header {
      border-bottom: 1px solid #e5e7eb;
      background: #fff;
    }

    .header-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      color: #172033;
      text-decoration: none;
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 70px 28px 100px;
    }

    .category {
      color: #2457d6;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 14px;
    }

    h1 {
      margin: 0;
      font-size: 46px;
      line-height: 1.1;
      letter-spacing: -1.5px;
    }

    .subtitle {
      margin: 14px 0 38px;
      color: #667085;
      font-size: 18px;
    }

    .tool {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      padding: 24px;
      box-shadow: 0 8px 30px rgba(16, 24, 40, 0.05);
    }

    textarea {
      width: 100%;
      min-height: 280px;
      resize: vertical;
      border: 1px solid #d9dee8;
      border-radius: 12px;
      padding: 18px;
      font-size: 16px;
      line-height: 1.6;
      font-family: inherit;
      outline: none;
      color: #172033;
    }

    textarea:focus {
      border-color: #2474e8;
      box-shadow: 0 0 0 3px rgba(36, 116, 232, 0.1);
    }

    .actions {
      display: flex;
      gap: 12px;
      margin-top: 16px;
    }

    button {
      border: none;
      border-radius: 10px;
      padding: 13px 22px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .primary {
      background: #1769e0;
      color: white;
      flex: 1;
    }

    .secondary {
      background: #f2f4f7;
      color: #344054;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-top: 22px;
    }

    .stat {
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      min-width: 0;
    }

    .number {
      display: block;
      font-size: 28px;
      font-weight: 800;
      color: #172033;
      margin-bottom: 5px;
    }

    .label {
      color: #667085;
      font-size: 13px;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    @media (max-width: 700px) {
      .container {
        padding: 45px 18px 70px;
      }

      h1 {
        font-size: 36px;
      }

      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .actions {
        flex-direction: column;
      }

    .primary {
        flex: none;
      }
    }

    button:focus-visible {
      outline: 3px solid #f4a261;
      outline-offset: 3px;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <main class="container">
    <div class="category">{ui.category}</div>

    <h1>{ui.title}</h1>

    <p class="subtitle">
      {ui.description}
    </p>

    <section class="tool">
      <label class="sr-only" for="texto">{ui.inputLabel}</label>
      <textarea
        id="texto"
        placeholder={ui.placeholder}
      ></textarea>

      <div class="actions">
        <button class="primary" id="contar" type="button">
          {ui.count}
        </button>

        <button class="secondary" id="limpar" type="button">
          {toolUi.common.clear}
        </button>
      </div>

      <div class="stats">
        <div class="stat">
          <span class="number" id="palavras">0</span>
          <span class="label">{ui.words}</span>
        </div>

        <div class="stat">
          <span class="number" id="caracteres">0</span>
          <span class="label">{ui.charactersWithSpaces}</span>
        </div>

        <div class="stat">
          <span class="number" id="caracteresSemEspacos">0</span>
          <span class="label">{ui.charactersWithoutSpaces}</span>
        </div>

        <div class="stat">
          <span class="number" id="frases">0</span>
          <span class="label">{ui.sentences}</span>
        </div>

        <div class="stat">
          <span class="number" id="linhas">0</span>
          <span class="label">{ui.lines}</span>
        </div>

        <div class="stat">
          <span class="number" id="paragrafos">0</span>
          <span class="label">{ui.paragraphs}</span>
        </div>

        <div class="stat">
          <span class="number" id="tempoLeitura">{ui.readingZero}</span>
          <span class="label">{ui.readingTime}</span>
        </div>
      </div>
      <p id="counterStatus" class="sr-only" aria-live="polite"></p>
    </section>
    <ToolEditorialContent content={editorialContent} relatedTools={editorialRelatedTools} />
  </main>

  <script id="wordCounterCopy" type="application/json" set:html={JSON.stringify(ui)}></script>
  <script>
    import { formatReadingTime, getWordCounterMetrics } from "../../lib/word-counter";

    const texto = document.getElementById("texto");
    const contar = document.getElementById("contar");
    const limpar = document.getElementById("limpar");

    const palavras = document.getElementById("palavras");
    const caracteres = document.getElementById("caracteres");
    const caracteresSemEspacos = document.getElementById("caracteresSemEspacos");
    const frases = document.getElementById("frases");
    const linhas = document.getElementById("linhas");
    const paragrafos = document.getElementById("paragrafos");
    const tempoLeitura = document.getElementById("tempoLeitura");
    const status = document.getElementById("counterStatus");
    const copy = JSON.parse(document.getElementById("wordCounterCopy")?.textContent ?? "{}");

    function atualizarContagem(announce = false) {
      const metrics = getWordCounterMetrics(texto.value);
      palavras.textContent = metrics.words.toLocaleString(copy.numberLocale);
      caracteres.textContent = metrics.charactersWithSpaces.toLocaleString(copy.numberLocale);
      caracteresSemEspacos.textContent = metrics.charactersWithoutSpaces.toLocaleString(copy.numberLocale);
      frases.textContent = metrics.sentences.toLocaleString(copy.numberLocale);
      linhas.textContent = metrics.lines.toLocaleString(copy.numberLocale);
      paragrafos.textContent = metrics.paragraphs.toLocaleString(copy.numberLocale);
      tempoLeitura.textContent = formatReadingTime(metrics.words, copy);
      if (announce) status.textContent = copy.metricsUpdated;
    }

    contar.addEventListener("click", () => atualizarContagem(true));

    texto.addEventListener("input", () => atualizarContagem());

    limpar.addEventListener("click", () => {
      texto.value = "";

      palavras.textContent = "0";
      atualizarContagem();
      status.textContent = copy.cleared;

      texto.focus();
    });
  </script>
</Layout>
