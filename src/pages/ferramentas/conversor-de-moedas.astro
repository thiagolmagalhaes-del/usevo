---
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
const ferramenta = getFerramentaByPath(Astro.url.pathname);
const toolMeta = getFerramentaTranslation(ferramenta, "en");
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);

const moedas = [
  { codigo: "BRL", nome: "Brazilian Real" },
  { codigo: "USD", nome: "US Dollar" },
  { codigo: "EUR", nome: "Euro" },
  { codigo: "GBP", nome: "British Pound" },
  { codigo: "JPY", nome: "Japanese Yen" },
  { codigo: "AUD", nome: "Australian Dollar" },
  { codigo: "CAD", nome: "Canadian Dollar" },
  { codigo: "CHF", nome: "Swiss Franc" },
  { codigo: "CNY", nome: "Chinese Yuan" },
  { codigo: "SEK", nome: "Swedish Krona" },
  { codigo: "NOK", nome: "Norwegian Krone" },
  { codigo: "MXN", nome: "Mexican Peso" }
];
---



<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title} | USEVO TOOLS</title>

  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  
  <link rel="alternate" hreflang="pt-BR" href={alternateUrls["pt-BR"]} />
  <link rel="alternate" hreflang="en" href={alternateUrls.en} />
  <link rel="alternate" hreflang="es" href={alternateUrls.es} />
  
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: #172033;
      background: #ffffff;
    }

    header {
      border-bottom: 1px solid #eeeeee;
      padding: 28px 6%;
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      text-decoration: none;
      color: #172033;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .back {
      color: #667085;
      text-decoration: none;
      font-size: 14px;
    }

    .back:hover {
      color: #2463eb;
    }

    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .category {
      display: inline-block;
      color: #3157d5;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 16px;
    }

    h1 {
      font-size: 48px;
      line-height: 1.1;
      margin: 0 0 14px;
      letter-spacing: -2px;
    }

    .description {
      color: #667085;
      font-size: 18px;
      margin: 0 0 40px;
    }

    .card {
      border: 1px solid #e7e9ee;
      border-radius: 18px;
      padding: 32px;
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.04);
      background: #ffffff;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 22px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 9px;
    }

    input,
    select {
      width: 100%;
      height: 52px;
      padding: 0 15px;
      border: 1px solid #d9dde5;
      border-radius: 10px;
      background: #ffffff;
      color: #172033;
      font-size: 16px;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: #3157d5;
      box-shadow: 0 0 0 3px rgba(49, 87, 213, 0.08);
    }

    .value-field {
      margin-bottom: 22px;
    }

    .convert {
      width: 100%;
      height: 54px;
      border: 0;
      border-radius: 10px;
      background: #2463eb;
      color: #ffffff;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s;
    }

    .convert:hover {
      opacity: 0.92;
    }

    .convert:disabled {
      opacity: 0.65;
      cursor: wait;
    }

    .swap {
      display: flex;
      justify-content: center;
      margin: -5px 0 18px;
    }

    .swap button {
      width: 42px;
      height: 42px;
      border: 1px solid #d9dde5;
      border-radius: 50%;
      background: #ffffff;
      color: #2463eb;
      font-size: 19px;
      cursor: pointer;
    }

    .result {
      display: none;
      margin-top: 25px;
      padding: 24px;
      border-radius: 14px;
      background: #f5f7ff;
      text-align: center;
    }

    .result.show {
      display: block;
    }

    .result-label {
      color: #667085;
      font-size: 14px;
      margin-bottom: 8px;
    }

    .result-value {
      font-size: 34px;
      font-weight: 800;
      color: #172033;
    }

    .rate {
      margin-top: 10px;
      color: #667085;
      font-size: 13px;
    }

    .date {
      margin-top: 5px;
      color: #98a2b3;
      font-size: 12px;
    }

    .error {
      display: none;
      margin-top: 18px;
      padding: 14px;
      border-radius: 10px;
      background: #fff5f5;
      color: #c0392b;
      font-size: 14px;
      text-align: center;
    }

    @media (max-width: 650px) {
      main {
        padding: 55px 18px;
      }

      h1 {
        font-size: 36px;
      }

      .row {
        grid-template-columns: 1fr;
        gap: 15px;
      }

      .card {
        padding: 22px;
      }

      .header-inner {
        gap: 20px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="header-inner">
      <a href="/" class="logo">USEVO TOOLS</a>

      <a href="/ferramentas" class="back">
        ← Back to tools
      </a>
    </div>
  </header>

  <main>

    <span class="category">Finance</span>

    <h1>{title}</h1>

    <p class="description">
      {description}
    </p>

    <div class="card">

      <div class="row">

        <div>
          <label for="from">From</label>

          <select id="from">
            {moedas.map((moeda) => (
              <option
                value={moeda.codigo}
                selected={moeda.codigo === "BRL"}
              >
                {moeda.codigo} — {moeda.nome}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="to">To</label>

          <select id="to">
            {moedas.map((moeda) => (
              <option
                value={moeda.codigo}
                selected={moeda.codigo === "USD"}
              >
                {moeda.codigo} — {moeda.nome}
              </option>
            ))}
          </select>
        </div>

      </div>

      <div class="swap">
        <button id="swap" type="button" title="Swap currencies">
          ⇄
        </button>
      </div>

      <div class="value-field">

        <label for="amount">
          Amount
        </label>

        <input
          id="amount"
          type="number"
          min="0"
          step="any"
          placeholder="Enter a value"
        />

      </div>

      <button class="convert" id="convert" type="button">
        Convert
      </button>

      <div class="error" id="error"></div>

      <div class="result" id="result">

        <div class="result-label">
          Result
        </div>

        <div class="result-value" id="resultValue"></div>

        <div class="rate" id="rate"></div>

        <div class="date" id="date"></div>

      </div>

    </div>

  </main>

  <script>
    const amount = document.getElementById("amount");
    const from = document.getElementById("from");
    const to = document.getElementById("to");

    const button = document.getElementById("convert");
    const swapButton = document.getElementById("swap");

    const result = document.getElementById("result");
    const resultValue = document.getElementById("resultValue");
    const rateText = document.getElementById("rate");
    const dateText = document.getElementById("date");
    const error = document.getElementById("error");

    function showError(message) {
      error.textContent = message;
      error.style.display = "block";
      result.classList.remove("show");
    }

    function hideError() {
      error.style.display = "none";
    }

    swapButton.addEventListener("click", () => {
      const oldFrom = from.value;

      from.value = to.value;
      to.value = oldFrom;

      if (amount.value) {
        button.click();
      }
    });

    button.addEventListener("click", async () => {

      const value = Number(amount.value);

      hideError();

      if (!value || value < 0) {
        showError("Enter a valid value.");
        return;
      }

      button.textContent = "Converting...";
      button.disabled = true;

      try {

        if (from.value === to.value) {

          resultValue.textContent =
            `${value.toLocaleString("pt-BR", {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            })} ${to.value}`;

          rateText.textContent =
            `1 ${from.value} = 1 ${to.value}`;

          dateText.textContent =
            "Direct conversion";

          result.classList.add("show");

          return;
        }

        const response = await fetch(
          `https://api.frankfurter.dev/v2/rate/${from.value}/${to.value}`
        );

        if (!response.ok) {
          throw new Error("Could not fetch the exchange rate.");
        }

        const data = await response.json();

        const rate = data.rate;
        const converted = value * rate;

        resultValue.textContent =
          `${converted.toLocaleString("pt-BR", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          })} ${to.value}`;

        rateText.textContent =
          `1 ${from.value} = ${rate.toLocaleString("pt-BR", {
            minimumFractionDigits: 4,
            maximumFractionDigits: 8
          })} ${to.value}`;

        if (data.date) {
          dateText.textContent =
            `Rate as of ${data.date}`;
        } else {
          dateText.textContent = "";
        }

        result.classList.add("show");

      } catch (err) {

        showError(
          "Could not fetch the exchange rate right now. Please try again."
        );

      } finally {

        button.textContent = "Convert";
        button.disabled = false;

      }

    });

    amount.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        button.click();
      }
    });
  </script>

</body>
</html>
