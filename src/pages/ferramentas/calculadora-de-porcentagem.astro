---
import Layout from "../../layouts/Layout.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
import { getToolUi } from "../../data/i18n";
const { locale = "en" } = Astro.props as { locale?: "en" | "es" | "pt-BR" };
const toolUi = getToolUi(locale);
const ui = toolUi.tools["calculadora-de-porcentagem"];
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/calculadora-de-porcentagem");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---



<Layout title={title} description={description} canonical={canonicalUrl} alternateUrls={alternateUrls} locale={locale}>
    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f7f8;
        color: #171717;
      }

      .container {
        width: min(100% - 32px, 900px);
        margin: 0 auto;
      }

      header {
        background: #ffffff;
        border-bottom: 1px solid #e5e5e5;
      }

      .header-inner {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        font-size: 28px;
        font-weight: 800;
        text-decoration: none;
        color: #111111;
      }

      .back {
        display: block;
        text-decoration: none;
        color: #555;
        font-size: 14px;
        margin-bottom: 16px;
      }

      main {
        padding: 56px 0 80px;
      }

      .eyebrow {
        color: #666;
        font-size: 14px;
        margin-bottom: 10px;
      }

      h1 {
        margin: 0;
        font-size: clamp(32px, 5vw, 48px);
        line-height: 1.1;
      }

      .intro {
        margin-top: 16px;
        color: #666;
        font-size: 18px;
        line-height: 1.6;
      }

      .calculator {
        margin-top: 40px;
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
      }

      .field {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
      }

      input {
        width: 100%;
        padding: 15px;
        border: 1px solid #d8d8d8;
        border-radius: 10px;
        font-size: 17px;
        outline: none;
      }

      input:focus {
        border-color: #111;
      }

      button {
        width: 100%;
        border: 0;
        border-radius: 10px;
        padding: 16px;
        background: #111;
        color: white;
        font-size: 17px;
        font-weight: 700;
        cursor: pointer;
      }

      button:hover {
        opacity: 0.9;
      }

      .result {
        display: none;
        margin-top: 24px;
        padding: 22px;
        border-radius: 14px;
        background: #f2f2f2;
      }

      .result.visible {
        display: block;
      }

      .result-label {
        color: #666;
        font-size: 14px;
      }

      .result-value {
        margin-top: 6px;
        font-size: 34px;
        font-weight: 800;
      }

      .formula {
        margin-top: 12px;
        color: #666;
        font-size: 14px;
      }

      footer {
        padding: 30px 0;
        border-top: 1px solid #e5e5e5;
        color: #777;
        font-size: 14px;
        text-align: center;
      }
    </style>

  <main>
    <div class="container">
      <a href="/ferramentas" class="back">← {toolUi.common.back}</a>
        <div class="eyebrow">{ui.onlineTools} › {ui.category}</div>

        <h1>{ui.title}</h1>

        <p class="intro">
          {ui.description}
        </p>

        <section class="calculator">
          <div class="field">
            <label for="percentage">{ui.percentage}</label>
            <input
              id="percentage"
              type="number"
              placeholder={ui.percentagePlaceholder}
              step="any"
            />
          </div>

          <div class="field">
            <label for="value">{ui.value}</label>
            <input
              id="value"
              type="number"
              placeholder={ui.valuePlaceholder}
              step="any"
            />
          </div>

          <button id="calculate">{ui.calculate}</button>

          <div id="result" class="result">
            <div class="result-label">{ui.result}</div>
            <div id="resultValue" class="result-value">0</div>
            <div id="formula" class="formula" data-template={ui.formula}></div>
          </div>
        </section>
      </div>
    </main>

    <footer>
      © {new Date().getFullYear()} USEVO TOOLS — {ui.onlineTools}
    </footer>

    <script>
      const percentageInput = document.getElementById(
        "percentage"
      ) as HTMLInputElement;

      const valueInput = document.getElementById(
        "value"
      ) as HTMLInputElement;

      const calculateButton = document.getElementById(
        "calculate"
      ) as HTMLButtonElement;

      const result = document.getElementById("result") as HTMLDivElement;
      const resultValue = document.getElementById(
        "resultValue"
      ) as HTMLDivElement;

      const formula = document.getElementById("formula") as HTMLDivElement;
      const formulaTemplate = formula.dataset.template ?? "";
      const numberFormatter = new Intl.NumberFormat(undefined, {
        minimumFractionDigits: 0,
        maximumFractionDigits: 2,
      });

      calculateButton.addEventListener("click", () => {
        const percentage = Number(percentageInput.value);
        const value = Number(valueInput.value);

        if (!Number.isFinite(percentage) || !Number.isFinite(value)) {
          result.classList.remove("visible");
          return;
        }

        const calculated = (percentage / 100) * value;

        resultValue.textContent = numberFormatter.format(calculated);

        formula.textContent = formulaTemplate
          .replace("{percentage}", String(percentage))
          .replace(
            "{value}",
            numberFormatter.format(value)
          )
          .replace(
            "{calculated}",
            numberFormatter.format(calculated)
          );

        result.classList.add("visible");
      });
    </script>
</Layout>
