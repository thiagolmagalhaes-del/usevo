---
import ImageConverter from "../../components/tools/ImageConverter.astro";
import ToolEditorialContent from "../../components/tools/ToolEditorialContent.astro";
import { getEditorialRelatedTools, getToolEditorialContent } from "../../data/tool-editorial-content";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";
import Layout from "../../layouts/Layout.astro";
const { locale: localeProp } = Astro.props as { locale?: Locale }; const locale=resolveLocaleFromPath(Astro.url.pathname,localeProp); const ferramenta=getFerramentaByPath("/ferramentas/converter-imagem"); const meta=getFerramentaTranslation(ferramenta,locale); const content=getToolEditorialContent(ferramenta?.id,locale);
---
<Layout title={meta.title} description={meta.description} canonical={new URL(Astro.url.pathname,"https://usevo.tools").href} alternateUrls={getSiteAlternates(Astro.url.pathname)} locale={locale}><ImageConverter locale={locale}/><div style="padding:0 28px 80px;max-width:900px;margin:0 auto"><ToolEditorialContent content={content} relatedTools={getEditorialRelatedTools(content,locale)}/></div></Layout>
