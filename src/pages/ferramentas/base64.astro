---
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/base64");
const toolMeta = getFerramentaTranslation(ferramenta, "en");
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---



<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | USEVO TOOLS</title>
    <meta
      name="description"
      content={description}
    />
    <link rel="alternate" hreflang="pt-BR" href={alternateUrls["pt-BR"]} />
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="es" href={alternateUrls.es} />
    <link rel="canonical" href={canonicalUrl} />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #ffffff;
        color: #172033;
      }

      .header {
        width: 100%;
        padding: 28px 5%;
        border-bottom: 1px solid #eeeeee;
      }

      .logo {
        font-size: 25px;
        font-weight: 800;
        color: #172033;
        text-decoration: none;
        letter-spacing: -1px;
      }

      .back {
        float: right;
        color: #555;
        text-decoration: none;
        font-size: 15px;
        margin-top: 5px;
      }

      .container {
        max-width: 900px;
        margin: 70px auto;
        padding: 0 25px;
      }

      .category {
        color: #2563eb;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      h1 {
        font-size: 46px;
        line-height: 1.1;
        margin: 0 0 12px;
        letter-spacing: -1.5px;
      }

      .description {
        color: #667085;
        font-size: 18px;
        margin-bottom: 38px;
      }

      .card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      }

      label {
        display: block;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      textarea {
        width: 100%;
        min-height: 250px;
        resize: vertical;
        border: 1px solid #d9dee8;
        border-radius: 12px;
        padding: 18px;
        font-family: monospace;
        font-size: 14px;
        line-height: 1.6;
        outline: none;
      }

      textarea:focus {
        border-color: #2563eb;
      }

      .buttons {
        display: flex;
        gap: 12px;
        margin-top: 18px;
        flex-wrap: wrap;
      }

      button {
        border: none;
        border-radius: 10px;
        padding: 14px 22px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
      }

      .primary {
        background: #2563eb;
        color: white;
        flex: 1;
      }

      .secondary {
        background: #f1f5f9;
        color: #172033;
      }

      .result {
        margin-top: 22px;
        display: none;
      }

      .result-label {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      .result-box {
        width: 100%;
        min-height: 140px;
        padding: 18px;
        border: 1px solid #d9dee8;
        border-radius: 12px;
        background: #f8fafc;
        font-family: monospace;
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .success {
        margin-top: 14px;
        padding: 14px;
        border-radius: 10px;
        background: #ecfdf3;
        color: #087443;
        font-size: 14px;
      }

      .error {
        margin-top: 14px;
        padding: 14px;
        border-radius: 10px;
        background: #fef2f2;
        color: #b42318;
        font-size: 14px;
      }

      @media (max-width: 600px) {
        .container {
          margin: 45px auto;
        }

        h1 {
          font-size: 36px;
        }

        .back {
          display: none;
        }

        .card {
          padding: 18px;
        }
      }
    </style>
  </head>

  <body>
    <header class="header">
      <a href="/" class="logo">USEVO TOOLS</a>
      <a href="/ferramentas" class="back">← Back to tools</a>
    </header>

    <main class="container">
      <div class="category">Development</div>

      <h1>Base64 Encoder</h1>

      <p class="description">
        Convert text to Base64 and decode Base64 to text quickly.
      </p>

      <section class="card">
        <label for="inputText">Text or Base64</label>

        <textarea
          id="inputText"
          placeholder="Type or paste your text here..."
        ></textarea>

        <div class="buttons">
          <button class="primary" id="encodeBtn">
            Text → Base64
          </button>

          <button class="secondary" id="decodeBtn">
            Base64 → Text
          </button>

          <button class="secondary" id="clearBtn">
            Clear
          </button>
        </div>

        <div id="result" class="result">
          <div class="result-label">Result</div>

          <div id="resultBox" class="result-box"></div>

          <button class="secondary" id="copyBtn" style="margin-top: 12px;">
            Copy result
          </button>

          <div id="message"></div>
        </div>
      </section>
    </main>

    <script>
      const input = document.getElementById("inputText");
      const result = document.getElementById("result");
      const resultBox = document.getElementById("resultBox");
      const message = document.getElementById("message");

      const encodeBtn = document.getElementById("encodeBtn");
      const decodeBtn = document.getElementById("decodeBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      function showResult(value, text, type = "success") {
        result.style.display = "block";
        resultBox.textContent = value;
        message.textContent = text;
        message.className = type;
      }

      encodeBtn.addEventListener("click", () => {
        const text = input.value;

        if (!text.trim()) {
          showResult("", "✕ Enter some text to convert.", "error");
          return;
        }

        try {
          const encoded = btoa(
            unescape(encodeURIComponent(text))
          );

          showResult(
            encoded,
            "✓ Text converted to Base64 successfully!",
            "success"
          );
        } catch (error) {
          showResult(
            "",
            "✕ Could not convert the text.",
            "error"
          );
        }
      });

      decodeBtn.addEventListener("click", () => {
        const encoded = input.value.trim();

        if (!encoded) {
          showResult("", "✕ Enter a Base64 code.", "error");
          return;
        }

        try {
          const decoded = decodeURIComponent(
            escape(atob(encoded))
          );

          showResult(
            decoded,
            "✓ Base64 decoded successfully!",
            "success"
          );
        } catch (error) {
          showResult(
            "",
            "✕ Invalid Base64. Check the code and try again.",
            "error"
          );
        }
      });

      clearBtn.addEventListener("click", () => {
        input.value = "";
        result.style.display = "none";
        resultBox.textContent = "";
        message.textContent = "";
        message.className = "";
      });

      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(resultBox.textContent);

          message.textContent = "✓ Result copied!";
          message.className = "success";
        } catch (error) {
          message.textContent = "✕ Could not copy automatically.";
          message.className = "error";
        }
      });
    </script>
  </body>
</html>