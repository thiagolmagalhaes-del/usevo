---
import Layout from "../../layouts/Layout.astro";
import ToolEditorialContent from "../../components/tools/ToolEditorialContent.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getEditorialRelatedTools, getToolEditorialContent } from "../../data/tool-editorial-content";
import { getSiteAlternates } from "../../data/locale-routes";
import { getToolUi } from "../../data/i18n";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";
const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);
const toolUi = getToolUi(locale);
const ui = toolUi.tools.base64;
const base64Messages = {
  emptyTextError: ui.emptyTextError,
  encodeSuccess: ui.encodeSuccess,
  encodeError: ui.encodeError,
  emptyBase64Error: ui.emptyBase64Error,
  decodeSuccess: ui.decodeSuccess,
  invalidBase64Error: ui.invalidBase64Error,
  copiedSuccess: ui.copiedSuccess,
  copyError: ui.copyError,
};
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/base64");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const editorialContent = getToolEditorialContent(ferramenta?.id, locale);
const editorialRelatedTools = getEditorialRelatedTools(editorialContent, locale);
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---



<Layout title={title} description={description} canonical={canonicalUrl} alternateUrls={alternateUrls} locale={locale}>
  <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #ffffff;
        color: #172033;
      }

      .header {
        width: 100%;
        padding: 28px 5%;
        border-bottom: 1px solid #eeeeee;
      }

      .logo {
        font-size: 25px;
        font-weight: 800;
        color: #172033;
        text-decoration: none;
        letter-spacing: -1px;
      }

      .container {
        max-width: 900px;
        margin: 70px auto;
        padding: 0 25px;
      }

      .category {
        color: #2563eb;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      h1 {
        font-size: 46px;
        line-height: 1.1;
        margin: 0 0 12px;
        letter-spacing: -1.5px;
      }

      .description {
        color: #667085;
        font-size: 18px;
        margin-bottom: 38px;
      }

      .card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      }

      label {
        display: block;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      textarea {
        width: 100%;
        min-height: 250px;
        resize: vertical;
        border: 1px solid #d9dee8;
        border-radius: 12px;
        padding: 18px;
        font-family: monospace;
        font-size: 14px;
        line-height: 1.6;
        outline: none;
      }

      textarea:focus {
        border-color: #2563eb;
      }

      .buttons {
        display: flex;
        gap: 12px;
        margin-top: 18px;
        flex-wrap: wrap;
      }

      button {
        border: none;
        border-radius: 10px;
        padding: 14px 22px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
      }

      .primary {
        background: #2563eb;
        color: white;
        flex: 1;
      }

      .secondary {
        background: #f1f5f9;
        color: #172033;
      }

      .result {
        margin-top: 22px;
        display: none;
      }

      .result-label {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      .result-box {
        width: 100%;
        min-height: 140px;
        padding: 18px;
        border: 1px solid #d9dee8;
        border-radius: 12px;
        background: #f8fafc;
        font-family: monospace;
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .success {
        margin-top: 14px;
        padding: 14px;
        border-radius: 10px;
        background: #ecfdf3;
        color: #087443;
        font-size: 14px;
      }

      .error {
        margin-top: 14px;
        padding: 14px;
        border-radius: 10px;
        background: #fef2f2;
        color: #b42318;
        font-size: 14px;
      }

      @media (max-width: 600px) {
        .container {
          margin: 45px auto;
        }

        h1 {
          font-size: 36px;
        }

        .card {
          padding: 18px;
        }
      }
    </style>

  <main class="container">
      <div class="category">{ui.category}</div>

      <h1>{ui.title}</h1>

      <p class="description">
        {ui.description}
      </p>

      <section class="card">
      <ToolEditorialContent content={editorialContent} relatedTools={editorialRelatedTools} />
        <label for="inputText">{ui.inputLabel}</label>

        <textarea
          id="inputText"
          placeholder={ui.placeholder}
        ></textarea>

        <div class="buttons">
          <button class="primary" id="encodeBtn">
            {ui.textToBase64}
          </button>

          <button class="secondary" id="decodeBtn">
            {ui.base64ToText}
          </button>

          <button class="secondary" id="clearBtn">
            {toolUi.common.clear}
          </button>
        </div>

        <div id="result" class="result">
          <div class="result-label">{ui.result}</div>

          <div id="resultBox" class="result-box"></div>

          <button class="secondary" id="copyBtn" style="margin-top: 12px;">
            {ui.copyResult}
          </button>

          <div id="message"></div>
        </div>
      </section>
    </main>

    <script define:vars={{ base64Messages }}>
      const input = document.getElementById("inputText");
      const result = document.getElementById("result");
      const resultBox = document.getElementById("resultBox");
      const message = document.getElementById("message");

      const encodeBtn = document.getElementById("encodeBtn");
      const decodeBtn = document.getElementById("decodeBtn");
      const clearBtn = document.getElementById("clearBtn");
      const copyBtn = document.getElementById("copyBtn");

      function showResult(value, text, type = "success") {
        result.style.display = "block";
        resultBox.textContent = value;
        message.textContent = text;
        message.className = type;
      }

      encodeBtn.addEventListener("click", () => {
        const text = input.value;

        if (!text.trim()) {
          showResult("", base64Messages.emptyTextError, "error");
          return;
        }

        try {
          const encoded = btoa(
            unescape(encodeURIComponent(text))
          );

          showResult(
            encoded,
            base64Messages.encodeSuccess,
            "success"
          );
        } catch (error) {
          showResult(
            "",
            base64Messages.encodeError,
            "error"
          );
        }
      });

      decodeBtn.addEventListener("click", () => {
        const encoded = input.value.trim();

        if (!encoded) {
          showResult("", base64Messages.emptyBase64Error, "error");
          return;
        }

        try {
          const decoded = decodeURIComponent(
            escape(atob(encoded))
          );

          showResult(
            decoded,
            base64Messages.decodeSuccess,
            "success"
          );
        } catch (error) {
          showResult(
            "",
            base64Messages.invalidBase64Error,
            "error"
          );
        }
      });

      clearBtn.addEventListener("click", () => {
        input.value = "";
        result.style.display = "none";
        resultBox.textContent = "";
        message.textContent = "";
        message.className = "";
      });

      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(resultBox.textContent);

          message.textContent = base64Messages.copiedSuccess;
          message.className = "success";
        } catch (error) {
          message.textContent = base64Messages.copyError;
          message.className = "error";
        }
      });
    </script>
</Layout>
