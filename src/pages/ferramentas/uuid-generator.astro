---
import Layout from "../../layouts/Layout.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
const { locale = "en" } = Astro.props as { locale?: "en" | "es" | "pt-BR" };
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/uuid-generator");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---



<Layout title={title} description={description} canonical={canonicalUrl} alternateUrls={alternateUrls} locale={locale}>
    <main class="container">
      <a class="back" href="/ferramentas">← Back to tools</a>

      <div class="category">Development</div>

      <h1>{title}</h1>

      <p class="description">{description}</p>

      <section class="tool-card">
        <label for="uuid">UUID</label>

        <div class="uuid-row">
          <input
            id="uuid"
            type="text"
            readonly
            placeholder="Your UUID will appear here..."
          />

          <button id="copyButton" class="secondary" type="button">
            Copy
          </button>
        </div>

        <button id="generateButton" class="primary" type="button">
          Generate UUID
        </button>

        <div id="message" class="message" aria-live="polite"></div>
      </section>
    </main>

    <script>
      const uuidInput = document.getElementById("uuid");
      const generateButton = document.getElementById("generateButton");
      const copyButton = document.getElementById("copyButton");
      const message = document.getElementById("message");

      function generateUUID() {
        if (crypto.randomUUID) {
          return crypto.randomUUID();
        }

        return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(
          /[xy]/g,
          function (c) {
            const r = (Math.random() * 16) | 0;
            const v = c === "x" ? r : (r & 0x3) | 0x8;
            return v.toString(16);
          }
        );
      }

      function showMessage(text) {
        message.textContent = text;

        setTimeout(() => {
          message.textContent = "";
        }, 2500);
      }

      generateButton.addEventListener("click", () => {
        uuidInput.value = generateUUID();
        showMessage("✓ UUID generated successfully!");
      });

      copyButton.addEventListener("click", async () => {
        if (!uuidInput.value) {
          showMessage("Generate a UUID first.");
          return;
        }

        try {
          await navigator.clipboard.writeText(uuidInput.value);
          showMessage("✓ UUID copied to clipboard!");
        } catch {
          uuidInput.select();
          document.execCommand("copy");
          showMessage("✓ UUID copied!");
        }
      });
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family:
          Arial, Helvetica, sans-serif;
        background: #ffffff;
        color: #172033;
      }

      .container {
        width: min(900px, calc(100% - 40px));
        margin: 0 auto;
        padding: 45px 0 80px;
      }

      .back {
        display: block;
        text-align: right;
        margin-bottom: 70px;
        color: #555;
        text-decoration: none;
        font-size: 14px;
      }

      .back:hover {
        text-decoration: underline;
      }

      .category {
        color: #1266d6;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      h1 {
        margin: 0;
        font-size: clamp(38px, 6vw, 58px);
        line-height: 1.05;
        letter-spacing: -2px;
      }

      .description {
        margin: 18px 0 38px;
        font-size: 18px;
        line-height: 1.5;
        color: #666;
      }

      .tool-card {
        border: 1px solid #e5e5e5;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
      }

      label {
        display: block;
        margin-bottom: 10px;
        font-weight: 700;
        font-size: 15px;
      }

      .uuid-row {
        display: flex;
        gap: 10px;
        margin-bottom: 16px;
      }

      input {
        flex: 1;
        min-width: 0;
        height: 56px;
        padding: 0 18px;
        border: 1px solid #d9d9d9;
        border-radius: 10px;
        background: #fafafa;
        color: #222;
        font-family: monospace;
        font-size: 16px;
        outline: none;
      }

      input:focus {
        border-color: #1266d6;
      }

      button {
        border: 0;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition:
          transform 0.1s ease,
          opacity 0.2s ease;
      }

      button:active {
        transform: scale(0.99);
      }

      .primary {
        width: 100%;
        height: 56px;
        background: #0878e8;
        color: white;
      }

      .primary:hover {
        opacity: 0.9;
      }

      .secondary {
        padding: 0 24px;
        background: #f1f1f1;
        color: #222;
      }

      .secondary:hover {
        background: #e7e7e7;
      }

      .message {
        min-height: 24px;
        margin-top: 18px;
        color: #198754;
        font-size: 14px;
        font-weight: 600;
      }

      @media (max-width: 650px) {
        .container {
          width: min(100% - 24px, 900px);
          padding-top: 25px;
        }

        .back {
          margin-bottom: 45px;
        }

        .tool-card {
          padding: 20px;
        }

        .uuid-row {
          flex-direction: column;
        }

        .secondary {
          height: 48px;
        }

        input {
          width: 100%;
        }
      }
    </style>
</Layout>