---
import Layout from "../../layouts/Layout.astro";
import ImageCompressor from "../../components/tools/ImageCompressor.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
const { locale = "en" } = Astro.props as { locale?: "en" | "es" | "pt-BR" };
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/comprimir-imagem");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const title = toolMeta.title;
const description = toolMeta.description;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---


<Layout title={title} description={description} canonical={new URL(Astro.url.pathname, "https://usevo.tools").href} alternateUrls={alternateUrls} locale={locale}>
  <div style="padding:28px; max-width:900px; margin:0 auto">
    <ImageCompressor />
  </div>
</Layout>