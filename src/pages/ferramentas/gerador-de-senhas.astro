---
import Layout from "../../layouts/Layout.astro";
import ToolEditorialContent from "../../components/tools/ToolEditorialContent.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getEditorialRelatedTools, getToolEditorialContent } from "../../data/tool-editorial-content";
import { getSiteAlternates } from "../../data/locale-routes";
import { getToolUi } from "../../data/i18n";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";
const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);
const toolUi = getToolUi(locale);
const ui = toolUi.tools["gerador-de-senhas"];
const passwordMessages = {
  copied: ui.copied,
  copy: ui.copy,
  selectAtLeastOneOption: ui.selectAtLeastOneOption,
  weak: ui.weak,
  strong: ui.strong,
  veryStrong: ui.veryStrong,
};
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/gerador-de-senhas");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const editorialContent = getToolEditorialContent(ferramenta?.id, locale);
const editorialRelatedTools = getEditorialRelatedTools(editorialContent, locale);
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---



<Layout title={title} description={description} canonical={canonicalUrl} alternateUrls={alternateUrls} locale={locale}>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      color: #172033;
    }

    header {
      border-bottom: 1px solid #e5e7eb;
      background: #fff;
    }

    .header-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      color: #172033;
      text-decoration: none;
      font-size: 25px;
      font-weight: 800;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 70px 28px 100px;
    }

    .category {
      color: #2457d6;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 14px;
    }

    h1 {
      margin: 0;
      font-size: 46px;
      line-height: 1.1;
      letter-spacing: -1.5px;
    }

    .subtitle {
      margin: 14px 0 38px;
      color: #667085;
      font-size: 18px;
    }

    .tool {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      padding: 26px;
      box-shadow: 0 8px 30px rgba(16, 24, 40, 0.05);
    }

    .password-box {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
    }

    #senha {
      flex: 1;
      min-width: 0;
      padding: 17px;
      border: 1px solid #d9dee8;
      border-radius: 10px;
      font-size: 18px;
      font-family: monospace;
      background: #f8fafc;
      color: #172033;
    }

    button {
      border: none;
      border-radius: 10px;
      padding: 14px 20px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .copy {
      background: #f2f4f7;
      color: #344054;
    }

    .generate {
      width: 100%;
      background: #1769e0;
      color: white;
      margin-top: 22px;
    }

    .length-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .length-label {
      font-weight: 700;
    }

    #lengthValue {
      font-weight: 800;
      color: #1769e0;
    }

    input[type="range"] {
      width: 100%;
      accent-color: #1769e0;
    }

    .options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 25px;
    }

    .option {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 13px;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      color: #344054;
      font-size: 14px;
      font-weight: 600;
    }

    .option input {
      width: 17px;
      height: 17px;
      accent-color: #1769e0;
    }

    .strength {
      margin-top: 22px;
      padding: 15px;
      background: #f8fafc;
      border-radius: 10px;
      text-align: center;
      font-weight: 700;
    }

    #strength {
      color: #1769e0;
    }

    @media (max-width: 650px) {
      .container {
        padding: 45px 18px 70px;
      }

      h1 {
        font-size: 36px;
      }

      .password-box {
        flex-direction: column;
      }

      .options {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main class="container">
    <div class="category">{ui.category}</div>

    <h1>{ui.title}</h1>

    <p class="subtitle">
      {ui.description}
    </p>

    <section class="tool">
      <div class="password-box">
        <input id="senha" type="text" readonly />
        <button class="copy" id="copiar">{ui.copy}</button>
      </div>

      <div class="length-row">
        <span class="length-label">{ui.passwordLength}</span>
        <span id="lengthValue">16</span>
      </div>

      <input
        id="length"
        type="range"
        min="6"
        max="40"
        value="16"
      />

      <div class="options">
        <label class="option">
          <input type="checkbox" id="maiusculas" checked />
          {ui.uppercaseLetters}
        </label>

        <label class="option">
          <input type="checkbox" id="minusculas" checked />
          {ui.lowercaseLetters}
        </label>

        <label class="option">
          <input type="checkbox" id="numeros" checked />
          {ui.numbers}
        </label>

        <label class="option">
          <input type="checkbox" id="simbolos" checked />
          {ui.symbols}
        </label>
      </div>

      <div class="strength">
        {ui.strength} <span id="strength">{ui.strong}</span>
      </div>

      <button class="generate" id="gerar">
        {ui.generateNewPassword}
      </button>
    </section>
    <ToolEditorialContent content={editorialContent} relatedTools={editorialRelatedTools} />
  </main>

  <script define:vars={{ passwordMessages }}>
    const senha = document.getElementById("senha");
    const copiar = document.getElementById("copiar");
    const gerar = document.getElementById("gerar");

    const length = document.getElementById("length");
    const lengthValue = document.getElementById("lengthValue");

    const maiusculas = document.getElementById("maiusculas");
    const minusculas = document.getElementById("minusculas");
    const numeros = document.getElementById("numeros");
    const simbolos = document.getElementById("simbolos");

    const strength = document.getElementById("strength");

    const conjuntos = {
      maiusculas: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      minusculas: "abcdefghijklmnopqrstuvwxyz",
      numeros: "0123456789",
      simbolos: "!@#$%^&*()_+-=[]{}|;:,.<>?"
    };

    function gerarSenha() {
      let caracteres = "";

      if (maiusculas.checked) {
        caracteres += conjuntos.maiusculas;
      }

      if (minusculas.checked) {
        caracteres += conjuntos.minusculas;
      }

      if (numeros.checked) {
        caracteres += conjuntos.numeros;
      }

      if (simbolos.checked) {
        caracteres += conjuntos.simbolos;
      }

      if (!caracteres) {
        senha.value = "";
        strength.textContent = passwordMessages.selectAtLeastOneOption;
        return;
      }

      const tamanho = Number(length.value);

      const valores = new Uint32Array(tamanho);
      crypto.getRandomValues(valores);

      let resultado = "";

      for (let i = 0; i < tamanho; i++) {
        resultado += caracteres[valores[i] % caracteres.length];
      }

      senha.value = resultado;
      atualizarForca();
    }

    function atualizarForca() {
      const tamanho = Number(length.value);

      let quantidade = 0;

      if (maiusculas.checked) quantidade++;
      if (minusculas.checked) quantidade++;
      if (numeros.checked) quantidade++;
      if (simbolos.checked) quantidade++;

      let resultado = passwordMessages.weak;

      if (tamanho >= 12 && quantidade >= 3) {
        resultado = passwordMessages.strong;
      }

      if (tamanho >= 16 && quantidade === 4) {
        resultado = passwordMessages.veryStrong;
      }

      strength.textContent = resultado;
    }

    length.addEventListener("input", () => {
      lengthValue.textContent = length.value;
      gerarSenha();
    });

    gerar.addEventListener("click", gerarSenha);

    maiusculas.addEventListener("change", gerarSenha);
    minusculas.addEventListener("change", gerarSenha);
    numeros.addEventListener("change", gerarSenha);
    simbolos.addEventListener("change", gerarSenha);

    copiar.addEventListener("click", async () => {
      if (!senha.value) return;

      await navigator.clipboard.writeText(senha.value);

      copiar.textContent = passwordMessages.copied;

      setTimeout(() => {
        copiar.textContent = passwordMessages.copy;
      }, 1500);
    });

    gerarSenha();
  </script>
</Layout>
