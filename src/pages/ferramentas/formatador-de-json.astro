---
import ToolEditorialContent from "../../components/tools/ToolEditorialContent.astro";
import { getEditorialRelatedTools, getToolEditorialContent } from "../../data/tool-editorial-content";
import Layout from "../../layouts/Layout.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
import { getToolUi, getCategoryTranslation } from "../../data/i18n";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";
const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/formatador-de-json");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const editorialContent = getToolEditorialContent(ferramenta?.id, locale);
const editorialRelatedTools = getEditorialRelatedTools(editorialContent, locale);
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
const toolUi = getToolUi(locale);
const category = getCategoryTranslation("development", locale);
const ui = toolUi.tools["formatador-de-json"];
---



<Layout title={title} description={description} canonical={canonicalUrl} alternateUrls={alternateUrls} locale={locale}>
    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #ffffff;
        color: #172033;
      }

      .header {
        width: 100%;
        padding: 28px 5%;
        border-bottom: 1px solid #eeeeee;
      }

      .logo {
        font-size: 25px;
        font-weight: 800;
        color: #172033;
        text-decoration: none;
        letter-spacing: -1px;
      }

      .container {
        max-width: 900px;
        margin: 70px auto;
        padding: 0 25px;
      }

      .category {
        color: #2563eb;
        font-size: 14px;
        font-weight: 700;
        padding-top: 4px;
        margin-bottom: 12px;
      }

      h1 {
        font-size: 46px;
        line-height: 1.1;
        margin: 0 0 12px;
        letter-spacing: -1.5px;
      }

      .description {
        color: #667085;
        font-size: 18px;
        margin-bottom: 38px;
      }

      .card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      }

      label {
        display: block;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      textarea {
        width: 100%;
        min-height: 320px;
        resize: vertical;
        border: 1px solid #d9dee8;
        border-radius: 12px;
        padding: 18px;
        font-family: monospace;
        font-size: 14px;
        line-height: 1.6;
        outline: none;
      }

      textarea:focus {
        border-color: #2563eb;
      }

      .buttons {
        display: flex;
        gap: 12px;
        margin-top: 18px;
        flex-wrap: wrap;
      }

      button {
        border: none;
        border-radius: 10px;
        padding: 14px 24px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
      }

      .primary {
        background: #2563eb;
        color: white;
        flex: 1;
      }

      .secondary {
        background: #f1f5f9;
        color: #172033;
      }

      .result {
        margin-top: 22px;
        padding: 16px;
        border-radius: 10px;
        display: none;
        font-size: 15px;
      }

      .success {
        display: block;
        background: #ecfdf3;
        color: #087443;
      }

      .error {
        display: block;
        background: #fef2f2;
        color: #b42318;
      }

      @media (max-width: 600px) {
        .container {
          margin: 45px auto;
        }

        h1 {
          font-size: 36px;
        }

        .card {
          padding: 18px;
        }
      }
    </style>

  <main class="container">
      <div class="category">{category}</div>

      <h1>{title}</h1>

      <p class="description">
        {description}
      </p>

      <section class="card">
        <label for="jsonInput">{ui.inputLabel}</label>

        <textarea
          id="jsonInput"
          placeholder={ui.placeholder}
        ></textarea>

        <div class="buttons">
          <button class="primary" id="formatBtn" type="button">
            {ui.format}
          </button>

          <button class="secondary" id="minifyBtn" type="button">
            {ui.minify}
          </button>

          <button class="secondary" id="clearBtn" type="button">
            {ui.clear}
          </button>
        </div>

        <div id="result" class="result"></div>
      </section>
    </main>

    <script id="jsonFormatterMessages" type="application/json" set:html={JSON.stringify(ui)}></script>
    <script>
      const messagesElement = document.getElementById("jsonFormatterMessages");
      const messages = JSON.parse(messagesElement?.textContent ?? "{}");
      const input = document.getElementById("jsonInput");
      const result = document.getElementById("result");
      const formatBtn = document.getElementById("formatBtn");
      const minifyBtn = document.getElementById("minifyBtn");
      const clearBtn = document.getElementById("clearBtn");

      function showMessage(message, type) {
        result.textContent = message;
        result.className = `result ${type}`;
      }

      formatBtn.addEventListener("click", () => {
        if (!input.value.trim()) {
          showMessage(messages.emptyInputError, "error");
          return;
        }

        try {
          const parsed = JSON.parse(input.value);

          input.value = JSON.stringify(parsed, null, 2);

          showMessage(messages.formatSuccess, "success");
        } catch (error) {
          showMessage(
            messages.formatError,
            "error"
          );
        }
      });

      minifyBtn.addEventListener("click", () => {
        if (!input.value.trim()) {
          showMessage(messages.emptyInputError, "error");
          return;
        }

        try {
          const parsed = JSON.parse(input.value);

          input.value = JSON.stringify(parsed);

          showMessage(messages.minifySuccess, "success");
        } catch (error) {
          showMessage(
            messages.minifyError,
            "error"
          );
        }
      });

      clearBtn.addEventListener("click", () => {
        input.value = "";
        result.textContent = "";
        result.className = "result";
      });
    </script>
  <div style="padding: 0 28px 80px; max-width: 900px; margin: 0 auto">
    <ToolEditorialContent content={editorialContent} relatedTools={editorialRelatedTools} />
  </div>
</Layout>
