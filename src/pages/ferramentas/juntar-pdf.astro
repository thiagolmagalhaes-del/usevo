---
import Layout from "../../layouts/Layout.astro";
import PdfMerger from "../../components/tools/PdfMerger.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
const ferramenta = getFerramentaByPath(Astro.url.pathname);
const toolMeta = getFerramentaTranslation(ferramenta, "pt-BR");
const title = toolMeta.title;
const description = toolMeta.description;
---


<Layout title={title} description={description} canonical={new URL(Astro.url.pathname, "https://thipatools.com").href}>
  <div style="padding:28px; max-width:900px; margin:0 auto">
    <PdfMerger />
  </div>
</Layout>