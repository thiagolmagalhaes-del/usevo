---
import Layout from "../../layouts/Layout.astro";
import {
  getFerramentaByPath,
  getFerramentaTranslation
} from "../../data/ferramentas";
import { getSiteAlternates, localeRouteConfig } from "../../data/locale-routes";
import { getToolUi } from "../../data/i18n";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";

const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);

const toolUi = getToolUi(locale);
const ui = toolUi.tools["jpg-para-pdf"];

const ferramenta = getFerramentaByPath("/ferramentas/jpg-para-pdf");
const toolMeta = getFerramentaTranslation(ferramenta, locale);

const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(
  Astro.url.pathname,
  "https://usevo.tools"
).href;

const alternateUrls = getSiteAlternates(Astro.url.pathname);
---

<Layout
  title={title}
  description={description}
  canonical={canonicalUrl}
  alternateUrls={alternateUrls}
  locale={locale}
>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #fff;
      color: #172033;
    }

    header {
      border-bottom: 1px solid #e8e8e8;
      padding: 24px 5%;
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      text-decoration: none;
      color: #172033;
      font-size: 24px;
      font-weight: 800;
    }

    .back {
      display: block;
      text-decoration: none;
      color: #667085;
      font-size: 15px;
      margin-bottom: 16px;
    }

    main {
      max-width: 900px;
      margin: 70px auto;
      padding: 0 24px;
    }

    .category {
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
      display: inline-block;
      margin-bottom: 14px;
    }

    h1 {
      margin: 0 0 12px;
      font-size: 48px;
      line-height: 1.1;
      letter-spacing: -1.5px;
    }

    .description {
      margin: 0 0 40px;
      color: #667085;
      font-size: 18px;
    }

    .card {
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      padding: 32px;
      background: white;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }

    .upload-area {
      border: 2px dashed #d1d5db;
      border-radius: 14px;
      padding: 50px 25px;
      text-align: center;
      cursor: pointer;
      transition: 0.2s;
    }

    .upload-area:hover {
      border-color: #2563eb;
      background: #f8fafc;
    }

    .upload-icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .upload-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .upload-text {
      color: #667085;
      font-size: 14px;
    }

    input[type="file"] {
      display: none;
    }

    [hidden] {
      display: none !important;
    }

    #preview {
      display: none;
      max-width: 100%;
      max-height: 400px;
      margin: 25px auto;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
    }

    .file-name {
      display: none;
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
      color: #475467;
    }

    button {
      width: 100%;
      margin-top: 20px;
      padding: 16px;
      border: 0;
      border-radius: 10px;
      background: #1677e8;
      color: white;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover:not(:disabled) {
      background: #1268cc;
    }

    button:disabled {
      background: #9ca3af;
      cursor: not-allowed;
    }

    .error {
      display: none;
      margin-top: 15px;
      color: #dc2626;
      text-align: center;
      font-size: 14px;
    }

    .success,
    .download-hint {
      display: none;
      margin-top: 20px;
      padding: 15px;
      border-radius: 10px;
      background: #f0fdf4;
      color: #166534;
      text-align: center;
      font-weight: 600;
    }

    .success:not([hidden]),
    .download-hint:not([hidden]) {
      display: block;
    }

    .download-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .download-actions a,
    .download-actions button {
      flex: 1;
      margin-top: 0;
      text-align: center;
      text-decoration: none;
    }

    .download-actions a {
      background: #166534;
    }

    .download-actions .secondary {
      background: #475467;
    }

    .download-hint {
      margin-top: 12px;
      color: #475467;
      font-size: 14px;
      text-align: center;
    }

    @media (max-width: 700px) {
      h1 {
        font-size: 36px;
      }

      .card {
        padding: 20px;
      }
    }
  </style>

  <main>
    <a href={localeRouteConfig[locale].tools} class="back">
      ← {toolUi.common.back}
    </a>

    <span class="category">{ui.category}</span>

    <h1>{ui.title}</h1>

    <p class="description">
      {ui.description}
    </p>

    <div
      id="jpgPdfCard"
      class="card"
      data-selected-image={ui.selectedImage}
      data-conversion-error={ui.conversionError}
      data-processing={ui.processing}
      data-pdf-ready={ui.pdfReady}
      data-download-blocked={ui.downloadBlocked}
      data-read-image-error={ui.readImageError}
    >
      <label for="fileInput" class="upload-area">
        <div class="upload-icon">📄</div>

        <div class="upload-title">
          {ui.dropImages}
        </div>

        <div class="upload-text">
          {ui.supportedFormats}
        </div>
      </label>

      <input
        id="fileInput"
        type="file"
        accept=".jpg,.jpeg,.png,image/jpeg,image/png"
      />

      <div id="fileName" class="file-name"></div>

      <button id="removeBtn" type="button" class="secondary" hidden>{ui.removeImage}</button>

      <img
        id="preview"
        alt={ui.imagePreviewAlt}
      />

      <button id="convertBtn" type="button" disabled>
        {ui.convertToPdf}
      </button>

      <div id="processing" class="success" hidden>{ui.processing}</div>

      <div
        id="error"
        class="error"
        data-invalid-image-error={ui.invalidImageError}
      ></div>

      <div id="success" class="success" hidden>
        {ui.pdfReady}
      </div>

      <div id="downloadActions" class="download-actions" hidden>
        <a id="downloadPdf" href="#" download="usevo-jpg-para-pdf.pdf">{ui.downloadPdf}</a>
        <a id="openPdf" class="secondary" href="#" target="_blank" rel="noopener noreferrer">{ui.openPdf}</a>
      </div>
      <p id="downloadHint" class="download-hint">{ui.downloadBlocked}</p>
      <button id="retryBtn" type="button" class="secondary" hidden>{ui.retry}</button>
    </div>
  </main>

  <script>
    import { jsPDF } from "jspdf";

    const fileInput = document.getElementById("fileInput");
    const preview = document.getElementById("preview");
    const fileName = document.getElementById("fileName");
    const removeBtn = document.getElementById("removeBtn");
    const convertBtn = document.getElementById("convertBtn");
    const error = document.getElementById("error");
    const success = document.getElementById("success");
    const processing = document.getElementById("processing");
    const downloadActions = document.getElementById("downloadActions");
    const downloadPdf = document.getElementById("downloadPdf");
    const openPdf = document.getElementById("openPdf");
    const downloadHint = document.getElementById("downloadHint");
    const retryBtn = document.getElementById("retryBtn");
    const card = document.getElementById("jpgPdfCard");
    const messages = {
      selectedImage: card.dataset.selectedImage,
      conversionError: card.dataset.conversionError,
      processing: card.dataset.processing,
      pdfReady: card.dataset.pdfReady,
      downloadBlocked: card.dataset.downloadBlocked,
      readImageError: card.dataset.readImageError,
    };

    let selectedFile = null;
    let currentPdfUrl = "";
    let isProcessing = false;
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

    if (
      fileInput &&
      preview &&
      fileName &&
      convertBtn &&
      error &&
      success
    ) {
      fileInput.addEventListener("change", handleFileSelection);
      convertBtn.addEventListener("click", convertToPdf);
      removeBtn.addEventListener("click", clearSelection);
      retryBtn.addEventListener("click", () => fileInput.click());
    }

    window.addEventListener("pagehide", clearPdf);

    function clearPdf() {
      if (currentPdfUrl) URL.revokeObjectURL(currentPdfUrl);
      currentPdfUrl = "";
      downloadPdf.removeAttribute("href");
      openPdf.removeAttribute("href");
      downloadActions.hidden = true;
      downloadHint.hidden = true;
      success.hidden = true;
    }

    function clearSelection() {
      if (isProcessing) return;
      selectedFile = null;
      fileInput.value = "";
      preview.removeAttribute("src");
      preview.style.display = "none";
      fileName.textContent = "";
      fileName.style.display = "none";
      removeBtn.hidden = true;
      convertBtn.disabled = true;
      clearPdf();
      error.style.display = "none";
    }

    function handleFileSelection() {
      const file = fileInput.files?.[0];

      selectedFile = null;
      clearPdf();
      convertBtn.disabled = true;
      preview.style.display = "none";
      fileName.style.display = "none";
      error.style.display = "none";
      success.style.display = "none";

      if (!file) {
        return;
      }

      const isSupported =
        file.type === "image/jpeg" ||
        file.type === "image/png" ||
        /\.(jpe?g|png)$/i.test(file.name);

      if (!isSupported) {
        error.textContent =
          error.dataset.invalidImageError ||
          "Please select a JPG, JPEG, or PNG image.";

        error.style.display = "block";
        return;
      }

      selectedFile = file;

      fileName.textContent = file.name;
      fileName.textContent = `${messages.selectedImage}: ${file.name}`;
      fileName.style.display = "block";
      removeBtn.hidden = false;

      const reader = new FileReader();

      reader.onload = (event) => {
        const result = event.target?.result;

        if (typeof result !== "string") {
          error.textContent = messages.readImageError;
          error.style.display = "block";
          selectedFile = null;
          convertBtn.disabled = true;
          return;
        }

        preview.src = result;
        preview.style.display = "block";
        convertBtn.disabled = false;
      };

      reader.onerror = () => {
        error.textContent = messages.readImageError;
        error.style.display = "block";
        selectedFile = null;
        convertBtn.disabled = true;
      };

      reader.readAsDataURL(file);
    }

    async function convertToPdf() {
      if (!selectedFile || isProcessing) {
        return;
      }

      isProcessing = true;
      fileInput.disabled = true;
      convertBtn.disabled = true;
      removeBtn.disabled = true;
      retryBtn.hidden = true;
      error.style.display = "none";
      success.hidden = true;
      processing.textContent = messages.processing;
      processing.hidden = false;
      clearPdf();

      const reader = new FileReader();

      reader.onload = (event) => {
        const imageData = event.target?.result;

        if (typeof imageData !== "string") {
          showConversionError();
          return;
        }

        const image = new Image();

        image.onload = () => {
          try {
            const orientation =
              image.width > image.height
                ? "landscape"
                : "portrait";

            const pdf = new jsPDF({
              orientation,
              unit: "px",
              format: [image.width, image.height]
            });

            const imageFormat =
              selectedFile.type === "image/png" ||
              /\.png$/i.test(selectedFile.name)
                ? "PNG"
                : "JPEG";

            pdf.addImage(
              imageData,
              imageFormat,
              0,
              0,
              image.width,
              image.height
            );

            const pdfBytes = pdf.output("arraybuffer");
            const header = new TextDecoder().decode(new Uint8Array(pdfBytes).subarray(0, 5));
            if (!pdfBytes.byteLength || header !== "%PDF-") throw new Error("Invalid PDF output");
            const pdfBlob = new Blob([pdfBytes], { type: "application/pdf" });
            currentPdfUrl = URL.createObjectURL(pdfBlob);
            downloadPdf.href = currentPdfUrl;
            downloadPdf.download = "usevo-jpg-para-pdf.pdf";
            openPdf.href = currentPdfUrl;
            downloadActions.hidden = false;
            success.textContent = messages.pdfReady;
            success.hidden = false;
            downloadHint.textContent = messages.downloadBlocked;
            downloadHint.hidden = !isIOS;

            if (!isIOS) {
              const automaticLink = document.createElement("a");
              automaticLink.href = currentPdfUrl;
              automaticLink.download = "usevo-jpg-para-pdf.pdf";
              automaticLink.style.display = "none";
              document.body.appendChild(automaticLink);
              automaticLink.click();
              automaticLink.remove();
            }
            processing.hidden = true;
            isProcessing = false;
            fileInput.disabled = false;
            removeBtn.disabled = false;
            convertBtn.disabled = false;
          } catch (conversionError) {
            console.error(
              "JPG to PDF conversion error:",
              conversionError
            );

            showConversionError();
          }
        };

        image.onerror = () => {
          showConversionError();
        };

        image.src = imageData;
      };

      reader.onerror = () => {
        showConversionError();
      };

      reader.readAsDataURL(selectedFile);
    }

    function showConversionError() {
      error.textContent = messages.conversionError;

      error.style.display = "block";
      retryBtn.hidden = false;
      processing.hidden = true;
      isProcessing = false;
      fileInput.disabled = false;
      removeBtn.disabled = false;
      convertBtn.disabled = !selectedFile;
    }
  </script>
</Layout>
