---
import ToolEditorialContent from "../../components/tools/ToolEditorialContent.astro";
import { getEditorialRelatedTools, getToolEditorialContent } from "../../data/tool-editorial-content";
import Layout from "../../layouts/Layout.astro";
import {
  getFerramentaByPath,
  getFerramentaTranslation
} from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
import { getToolUi } from "../../data/i18n";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";

const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);

const toolUi = getToolUi(locale);
const ui = toolUi.tools["jpg-para-pdf"];

const ferramenta = getFerramentaByPath("/ferramentas/jpg-para-pdf");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const editorialContent = getToolEditorialContent(ferramenta?.id, locale);
const editorialRelatedTools = getEditorialRelatedTools(editorialContent, locale);

const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(
  Astro.url.pathname,
  "https://usevo.tools"
).href;

const alternateUrls = getSiteAlternates(Astro.url.pathname);
---

<Layout
  title={title}
  description={description}
  canonical={canonicalUrl}
  alternateUrls={alternateUrls}
  locale={locale}
>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #fff;
      color: #172033;
    }

    header {
      border-bottom: 1px solid #e8e8e8;
      padding: 24px 5%;
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      text-decoration: none;
      color: #172033;
      font-size: 24px;
      font-weight: 800;
    }

    main {
      max-width: 900px;
      margin: 70px auto;
      padding: 0 24px;
    }

    .category {
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
      display: inline-block;
      margin-bottom: 14px;
    }

    h1 {
      margin: 0 0 12px;
      font-size: 48px;
      line-height: 1.1;
      letter-spacing: -1.5px;
    }

    .description {
      margin: 0 0 40px;
      color: #667085;
      font-size: 18px;
    }

    .card {
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      padding: 32px;
      background: white;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }

    .upload-area {
      border: 2px dashed #d1d5db;
      border-radius: 14px;
      padding: 50px 25px;
      text-align: center;
      cursor: pointer;
      transition: 0.2s;
    }

    .upload-area:hover {
      border-color: #2563eb;
      background: #f8fafc;
    }

    .upload-icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .upload-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .upload-text {
      color: #667085;
      font-size: 14px;
    }

    input[type="file"] {
      display: none;
    }

    [hidden] {
      display: none !important;
    }

    #preview {
      display: none;
      max-width: 100%;
      max-height: 400px;
      margin: 25px auto;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
    }

    .file-name {
      display: none;
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
      color: #475467;
    }

    button {
      width: 100%;
      margin-top: 20px;
      padding: 16px;
      border: 0;
      border-radius: 10px;
      background: #1677e8;
      color: white;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover:not(:disabled) {
      background: #1268cc;
    }

    button:disabled {
      background: #9ca3af;
      cursor: not-allowed;
    }

    .error {
      display: none;
      margin-top: 15px;
      color: #dc2626;
      text-align: center;
      font-size: 14px;
    }

    .success,
    .download-hint {
      display: none;
      margin-top: 20px;
      padding: 15px;
      border-radius: 10px;
      background: #f0fdf4;
      color: #166534;
      text-align: center;
      font-weight: 600;
    }

    .success:not([hidden]),
    .download-hint:not([hidden]) {
      display: block;
    }

    .download-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .download-actions a,
    .download-actions button {
      align-items: center;
      border: 1px solid transparent;
      border-radius: 10px;
      box-sizing: border-box;
      display: flex;
      flex: 1 1 220px;
      font-size: 16px;
      font-weight: 700;
      justify-content: center;
      line-height: 1.25;
      margin-top: 0;
      min-height: 48px;
      min-width: 0;
      padding: 12px 16px;
      text-align: center;
      text-decoration: none;
    }

    .download-actions a {
      background: #1677e8;
      color: #ffffff;
    }

    .download-actions a:hover {
      background: #1268cc;
    }

    .download-actions .secondary {
      background: #475467;
      color: #ffffff;
    }

    .download-actions .secondary:hover {
      background: #344054;
    }

    .download-actions a:focus-visible {
      outline: 3px solid #93c5fd;
      outline-offset: 2px;
    }

    .download-hint {
      margin-top: 12px;
      color: #475467;
      font-size: 14px;
      text-align: center;
    }

    .download-diagnostics {
      margin: 12px 0 0;
      padding: 12px;
      border: 1px solid #d0d5dd;
      border-radius: 8px;
      background: #f8fafc;
      color: #344054;
      font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      overflow-wrap: anywhere;
      text-align: left;
      white-space: pre-wrap;
    }

    @media (max-width: 700px) {
      h1 {
        font-size: 36px;
      }

      .card {
        padding: 20px;
      }

      .download-actions {
        flex-direction: column;
      }

      .download-actions a,
      .download-actions button {
        flex-basis: auto;
        width: 100%;
      }
    }
  </style>

  <main>
    <span class="category">{ui.category}</span>

    <h1>{ui.title}</h1>

    <p class="description">
      {ui.description}
    </p>

    <div
      id="jpgPdfCard"
      class="card"
      data-selected-image={ui.selectedImage}
      data-conversion-error={ui.conversionError}
      data-processing={ui.processing}
      data-pdf-ready={ui.pdfReady}
      data-download-blocked={ui.downloadBlocked}
      data-read-image-error={ui.readImageError}
    >
      <label for="fileInput" class="upload-area">
        <div class="upload-icon">📄</div>

        <div class="upload-title">
          {ui.dropImages}
        </div>

        <div class="upload-text">
          {ui.supportedFormats}
        </div>
      </label>

      <input
        id="fileInput"
        type="file"
        accept=".jpg,.jpeg,.png,image/jpeg,image/png"
      />

      <div id="fileName" class="file-name"></div>

      <button id="removeBtn" type="button" class="secondary" hidden>{ui.removeImage}</button>

      <img
        id="preview"
        alt={ui.imagePreviewAlt}
      />

      <button id="convertBtn" type="button" disabled>
        {ui.convertToPdf}
      </button>

      <div id="processing" class="success" hidden>{ui.processing}</div>

      <div
        id="error"
        class="error"
        data-invalid-image-error={ui.invalidImageError}
      ></div>

      <div id="success" class="success" hidden>
        {ui.pdfReady}
      </div>

      <div id="downloadActions" class="download-actions" hidden>
        <button id="downloadPdf" type="button">{ui.downloadPdf}</button>
        <a id="openPdf" class="secondary" href="#" target="_blank" rel="noopener noreferrer">{ui.openPdf}</a>
      </div>
      <p id="downloadHint" class="download-hint">{ui.downloadBlocked}</p>
      <output id="downloadDiagnostics" class="download-diagnostics" role="status" aria-live="polite" hidden></output>
      <button id="retryBtn" type="button" class="secondary" hidden>{ui.retry}</button>
    </div>
  </main>

  <script>
    import { jsPDF } from "jspdf";
    import { normalizeImageForPdf } from "../../lib/jpeg-orientation";
    import { browserPdfDownloadEnvironment, downloadPdf, inspectPdfDownload } from "../../lib/pdf-download";

    const fileInput = document.getElementById("fileInput");
    const preview = document.getElementById("preview");
    const fileName = document.getElementById("fileName");
    const removeBtn = document.getElementById("removeBtn");
    const convertBtn = document.getElementById("convertBtn");
    const error = document.getElementById("error");
    const success = document.getElementById("success");
    const processing = document.getElementById("processing");
    const downloadActions = document.getElementById("downloadActions");
    const downloadPdf = document.getElementById("downloadPdf");
    const openPdf = document.getElementById("openPdf");
    const downloadHint = document.getElementById("downloadHint");
    const downloadDiagnostics = document.getElementById("downloadDiagnostics");
    const retryBtn = document.getElementById("retryBtn");
    const card = document.getElementById("jpgPdfCard");
    const messages = {
      selectedImage: card.dataset.selectedImage,
      conversionError: card.dataset.conversionError,
      processing: card.dataset.processing,
      pdfReady: card.dataset.pdfReady,
      downloadBlocked: card.dataset.downloadBlocked,
      readImageError: card.dataset.readImageError,
    };

    let selectedFile = null;
    let selectedImage = null;
    let currentPdfBlob = null;
    let currentPdfUrl = "";
    let isProcessing = false;
    let selectionVersion = 0;
    const pdfFilename = "usevo-jpg-para-pdf.pdf";
    const downloadDiagnosticsMode = new URLSearchParams(window.location.search).get("download-diagnostics") === "1";

    if (
      fileInput &&
      preview &&
      fileName &&
      convertBtn &&
      error &&
      success
    ) {
      fileInput.addEventListener("change", handleFileSelection);
      convertBtn.addEventListener("click", convertToPdf);
      downloadPdf.addEventListener("click", downloadPdfFile);
      removeBtn.addEventListener("click", clearSelection);
      retryBtn.addEventListener("click", () => fileInput.click());
    }

    window.addEventListener("pagehide", clearPdf);

    function clearPdf() {
      if (currentPdfUrl) URL.revokeObjectURL(currentPdfUrl);
      currentPdfUrl = "";
      currentPdfBlob = null;
      openPdf.removeAttribute("href");
      downloadActions.hidden = true;
      downloadHint.hidden = true;
      downloadDiagnostics.hidden = true;
      downloadDiagnostics.textContent = "";
      success.hidden = true;
    }

    function appendDownloadDiagnostic(message) {
      if (!downloadDiagnosticsMode) return;
      downloadDiagnostics.textContent = `${downloadDiagnostics.textContent ? `${downloadDiagnostics.textContent}\n` : ""}${message}`;
      downloadDiagnostics.hidden = false;
    }

    function showDownloadDiagnostics(blob) {
      if (!downloadDiagnosticsMode) return;
      const { file, diagnostics } = inspectPdfDownload(blob, pdfFilename, browserPdfDownloadEnvironment());
      const canShareResult = diagnostics.canShareError || String(diagnostics.canShareFiles);
      downloadDiagnostics.textContent = [
        "Diagnóstico temporário de download ativo.",
        `window.isSecureContext: ${window.isSecureContext}`,
        `typeof File: ${typeof File}`,
        `typeof navigator.share: ${typeof navigator.share}`,
        `typeof navigator.canShare: ${typeof navigator.canShare}`,
        `navigator.canShare({ files: [pdfFile] }): ${canShareResult}`,
        `Blob: type=${blob.type}; size=${blob.size}`,
        `File: type=${file?.type ?? "não disponível"}; name=${file?.name ?? "não disponível"}; size=${file?.size ?? "não disponível"}`,
        `userAgent (somente diagnóstico): ${navigator.userAgent}`,
        "Estratégia: aguardando clique.",
      ].join("\n");
      downloadDiagnostics.hidden = false;
    }

    async function downloadPdfFile() {
      if (!currentPdfBlob) return;
      appendDownloadDiagnostic("Clique recebido.");
      const result = await downloadPdf(currentPdfBlob, pdfFilename, browserPdfDownloadEnvironment(), {
        diagnostic: downloadDiagnosticsMode,
        onStatus: appendDownloadDiagnostic,
      });
      appendDownloadDiagnostic(`Estratégia escolhida: ${result.strategy}.`);
      if (result.strategy === "share-error") {
        error.textContent = messages.conversionError;
        error.style.display = "block";
      }
    }

    function clearSelection() {
      if (isProcessing) return;
      selectedFile = null;
      selectedImage = null;
      selectionVersion += 1;
      fileInput.value = "";
      preview.removeAttribute("src");
      preview.style.display = "none";
      fileName.textContent = "";
      fileName.style.display = "none";
      removeBtn.hidden = true;
      convertBtn.disabled = true;
      clearPdf();
      error.style.display = "none";
    }

    async function handleFileSelection() {
      const file = fileInput.files?.[0];
      const version = ++selectionVersion;

      selectedFile = null;
      selectedImage = null;
      clearPdf();
      convertBtn.disabled = true;
      preview.style.display = "none";
      fileName.style.display = "none";
      error.style.display = "none";
      success.style.display = "none";

      if (!file) {
        return;
      }

      const isSupported =
        file.type === "image/jpeg" ||
        file.type === "image/png" ||
        /\.(jpe?g|png)$/i.test(file.name);

      if (!isSupported) {
        error.textContent =
          error.dataset.invalidImageError ||
          "Please select a JPG, JPEG, or PNG image.";

        error.style.display = "block";
        return;
      }

      fileName.textContent = file.name;
      fileName.textContent = `${messages.selectedImage}: ${file.name}`;
      fileName.style.display = "block";
      removeBtn.hidden = false;

      try {
        const normalized = await normalizeImageForPdf(file);
        if (version !== selectionVersion) return;
        selectedFile = file;
        selectedImage = normalized;
        preview.src = normalized.dataUrl;
        preview.style.display = "block";
        convertBtn.disabled = false;
      } catch {
        if (version !== selectionVersion) return;
        error.textContent = messages.readImageError;
        error.style.display = "block";
        selectedFile = null;
        selectedImage = null;
        convertBtn.disabled = true;
      }
    }

    async function convertToPdf() {
      if (!selectedFile || isProcessing) {
        return;
      }

      isProcessing = true;
      fileInput.disabled = true;
      convertBtn.disabled = true;
      removeBtn.disabled = true;
      retryBtn.hidden = true;
      error.style.display = "none";
      success.hidden = true;
      processing.textContent = messages.processing;
      processing.hidden = false;
      clearPdf();

      if (!selectedImage) {
        showConversionError();
        return;
      }

      try {
        const { dataUrl, dimensions } = selectedImage;
        const orientation = dimensions.width > dimensions.height ? "landscape" : "portrait";
        const pdf = new jsPDF({ orientation, unit: "px", format: [dimensions.width, dimensions.height] });
        const imageFormat = selectedFile.type === "image/png" || /\.png$/i.test(selectedFile.name) ? "PNG" : "JPEG";
        pdf.addImage(dataUrl, imageFormat, 0, 0, dimensions.width, dimensions.height);
        const pdfBytes = pdf.output("arraybuffer");
        const header = new TextDecoder().decode(new Uint8Array(pdfBytes).subarray(0, 5));
        if (!pdfBytes.byteLength || header !== "%PDF-") throw new Error("Invalid PDF output");
        const pdfBlob = new Blob([pdfBytes], { type: "application/pdf" });
        currentPdfBlob = pdfBlob;
        currentPdfUrl = URL.createObjectURL(pdfBlob);
        openPdf.href = currentPdfUrl;
        downloadActions.hidden = false;
        success.textContent = messages.pdfReady;
        success.hidden = false;
        downloadHint.textContent = messages.downloadBlocked;
        downloadHint.hidden = false;
        showDownloadDiagnostics(pdfBlob);
        processing.hidden = true;
        isProcessing = false;
        fileInput.disabled = false;
        removeBtn.disabled = false;
        convertBtn.disabled = false;
      } catch (conversionError) {
        console.error("JPG to PDF conversion error:", conversionError);
        showConversionError();
      }
    }

    function showConversionError() {
      error.textContent = messages.conversionError;

      error.style.display = "block";
      retryBtn.hidden = false;
      processing.hidden = true;
      isProcessing = false;
      fileInput.disabled = false;
      removeBtn.disabled = false;
      convertBtn.disabled = !selectedFile;
    }
  </script>
  <div style="padding: 0 28px 80px; max-width: 900px; margin: 0 auto">
    <ToolEditorialContent content={editorialContent} relatedTools={editorialRelatedTools} />
  </div>
</Layout>
