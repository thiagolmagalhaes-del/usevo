---
import Layout from "../../layouts/Layout.astro";
import ToolEditorialContent from "../../components/tools/ToolEditorialContent.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getEditorialRelatedTools, getToolEditorialContent } from "../../data/tool-editorial-content";
import { getSiteAlternates, getToolLocaleRouteById } from "../../data/locale-routes";
import { getToolUi } from "../../data/i18n";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";
const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);
const toolUi = getToolUi(locale);
const ui = toolUi.tools["gerador-de-qr-code"];
const qrMessages = { emptyInputError: ui.emptyInputError, generationError: ui.generationError };
// This component is also mounted inside /en/tools/[slug] and /es/herramientas/[slug],
// so the lookup must use this tool's canonical path, not the current route's pathname.
const ferramenta = getFerramentaByPath("/ferramentas/gerador-de-qr-code");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const editorialContent = getToolEditorialContent(ferramenta?.id, locale);
const editorialRelatedTools = getEditorialRelatedTools(editorialContent, locale);
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
const scannerRoute = getToolLocaleRouteById("leitor-de-qr-code", locale);
const scannerLink = locale === "pt-BR" ? "Ler um QR Code" : locale === "es" ? "Leer un código QR" : "Scan a QR Code";
---



<Layout title={title} description={description} canonical={canonicalUrl} alternateUrls={alternateUrls} locale={locale}>
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #ffffff;
        color: #172033;
      }

      header {
        border-bottom: 1px solid #e8e8e8;
        padding: 24px 5%;
      }

      .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        text-decoration: none;
        color: #172033;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }

      .back {
        display: block;
        text-decoration: none;
        color: #667085;
        font-size: 15px;
        margin-bottom: 16px;
      }

      main {
        max-width: 900px;
        margin: 70px auto;
        padding: 0 24px;
      }

      .category {
        display: inline-block;
        color: #2563eb;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 14px;
      }

      h1 {
        margin: 0 0 12px;
        font-size: 48px;
        line-height: 1.1;
        letter-spacing: -1.5px;
      }

      .description {
        margin: 0 0 40px;
        color: #667085;
        font-size: 18px;
      }

      .card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 32px;
        background: #ffffff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      }

      label {
        display: block;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
      }

      textarea {
        width: 100%;
        min-height: 180px;
        resize: vertical;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        padding: 18px;
        font-size: 16px;
        font-family: inherit;
        outline: none;
      }

      textarea:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }

      button {
        width: 100%;
        margin-top: 20px;
        border: 0;
        border-radius: 10px;
        padding: 16px;
        background: #1677e8;
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
      }

      button:hover {
        background: #1268cc;
      }

      .result {
        display: none;
        margin-top: 30px;
        padding: 30px;
        border-radius: 16px;
        background: #f8fafc;
        text-align: center;
      }

      .result.show {
        display: block;
      }

      .result h2 {
        margin: 0 0 20px;
        font-size: 20px;
      }

      #qrImage {
        display: block;
        width: 280px;
        height: 280px;
        max-width: 100%;
        margin: 0 auto 24px;
        background: white;
        padding: 10px;
        border-radius: 12px;
      }

      .download {
        display: inline-block;
        width: auto;
        margin: 0;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 10px;
        background: #172033;
        color: white;
        font-weight: 700;
      }

      .error {
        display: none;
        margin-top: 15px;
        color: #dc2626;
        font-size: 14px;
      }

      .scanner-link { margin:22px 0 0; text-align:center; }
      .scanner-link a { color:#234cbd; font-weight:700; }

      @media (max-width: 700px) {
        main {
          margin: 40px auto;
        }

        h1 {
          font-size: 36px;
        }

        .card {
          padding: 20px;
        }
      }
    </style>

  <main>
    <a href="/ferramentas" class="back">← {toolUi.common.back}</a>
      <span class="category">{ui.category}</span>

      <h1>{ui.title}</h1>

      <p class="description">
        {ui.description}
      </p>

      <div class="card">
        <label for="qrText">{ui.linkOrText}</label>

        <textarea
          id="qrText"
          placeholder={ui.placeholder}
        >https://google.com</textarea>

        <button id="generateBtn" type="button">
          {ui.generate}
        </button>

        <div id="error" class="error">
          {ui.emptyInputError}
        </div>

        <div id="result" class="result">
          <h2>{ui.yourQrCode}</h2>

          <img
            id="qrImage"
            alt={ui.generatedQrCodeAlt}
          />

          <a
            id="downloadBtn"
            class="download"
            href="#"
            download="usevo-qrcode.png"
            hidden
          >
            {ui.downloadQrCode}
          </a>
        </div>
        <p class="scanner-link"><a href={scannerRoute}>{scannerLink}</a></p>
        <ToolEditorialContent content={editorialContent} relatedTools={editorialRelatedTools} />
      </div>
    </main>

    <script id="qrMessages" type="application/json" set:html={JSON.stringify(qrMessages)}></script>
    <script>
      import QRCode from "qrcode";

      const qrMessages = JSON.parse(document.getElementById("qrMessages").textContent);
      const textInput = document.getElementById("qrText");
      const generateBtn = document.getElementById("generateBtn");
      const qrImage = document.getElementById("qrImage");
      const result = document.getElementById("result");
      const error = document.getElementById("error");
      const downloadBtn = document.getElementById("downloadBtn");
      let qrObjectUrl = "";

      const clearQrCode = () => {
        if (qrObjectUrl) URL.revokeObjectURL(qrObjectUrl);
        qrObjectUrl = "";
        qrImage.removeAttribute("src");
        downloadBtn.removeAttribute("href");
        downloadBtn.hidden = true;
        result.classList.remove("show");
      };

      const canvasToPng = (canvas) => new Promise((resolve, reject) => {
        canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error("Unable to create PNG.")), "image/png");
      });

      generateBtn.addEventListener("click", async () => {
        const text = textInput.value.trim();
        clearQrCode();

        if (!text) {
          error.textContent = qrMessages.emptyInputError;
          error.style.display = "block";
          return;
        }

        error.style.display = "none";
        try {
          const canvas = document.createElement("canvas");
          await QRCode.toCanvas(canvas, text, { width: 500, margin: 2 });
          const png = await canvasToPng(canvas);
          qrObjectUrl = URL.createObjectURL(png);
          qrImage.src = qrObjectUrl;
          downloadBtn.href = qrObjectUrl;
          downloadBtn.hidden = false;
          result.classList.add("show");
        } catch {
          error.textContent =
            qrMessages.generationError;
          error.style.display = "block";
        }
      });
    </script>
</Layout>
