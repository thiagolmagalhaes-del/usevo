---
import Layout from "../../layouts/Layout.astro";
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
import { resolveLocaleFromPath, type Locale } from "../../data/locales";

const { locale: localeProp } = Astro.props as { locale?: Locale };
const locale = resolveLocaleFromPath(Astro.url.pathname, localeProp);
const ferramenta = getFerramentaByPath("/ferramentas/calculadora-clt-pj");
const toolMeta = getFerramentaTranslation(ferramenta, locale);
const copy = {
  "pt-BR": { back: "Voltar", category: "Finanças", intro: "Compare o pacote econômico CLT brasileiro com uma proposta PJ. Os impostos PJ são uma estimativa informada por você.", country: "País", soon: "Em breve", soonText: "Esta calculadora ainda não está disponível para este país. Registramos seu interesse para priorizar uma versão local.", clt: "Cenário CLT (Brasil)", pj: "Cenário PJ (Brasil)", results: "Resultados", grossSalary: "Salário bruto mensal", dependents: "Dependentes", benefits: "Benefícios gerais mensais", meal: "Vale-alimentação/refeição", health: "Plano de saúde", otherBenefits: "Outros benefícios", revenue: "Faturamento bruto mensal", rate: "Impostos estimados (%)", accountant: "Contador", operational: "Custos operacionais", pjHealth: "Plano de saúde", social: "Previdência/contribuição", otherCosts: "Outros custos", vacationReserve: "Reserva para férias", bonusReserve: "Reserva equivalente ao 13º", cltGross: "Salário bruto", inss: "INSS", irrf: "IRRF", net: "Líquido mensal", thirteenth: "13º líquido estimado", vacation: "Adicional de férias", fgts: "FGTS (patrimônio mensal)", economicMonthly: "Valor econômico mensal", economicAnnual: "Valor econômico anual", taxes: "Impostos estimados", costs: "Custos", reserves: "Reservas", before: "Líquido antes das reservas", available: "Líquido mensal disponível", annual: "Líquido anual", difference: "Diferença mensal econômica", annualDiff: "Diferença anual", winner: "Maior valor", equivalent: "Faturamento PJ equivalente", cltWinner: "CLT", pjWinner: "PJ", tie: "Empate", note: "Os 12 salários já incluem o mês de férias; somente o adicional de 1/3 é somado. O FGTS é patrimônio e não renda disponível. O 13º é calculado separadamente e de forma conservadora.", privacy: "Os cálculos são feitos no seu navegador." },
  en: { back: "Back", category: "Finance", intro: "Compare the Brazilian CLT economic package with a PJ contractor offer. PJ taxes are an estimate you provide.", country: "Country", soon: "Coming soon", soonText: "This calculator is not available for this country yet. We recorded your interest to help prioritize a local version.", clt: "CLT scenario (Brazil)", pj: "PJ scenario (Brazil)", results: "Results", grossSalary: "Monthly gross salary", dependents: "Dependents", benefits: "General monthly benefits", meal: "Meal/food voucher", health: "Health insurance", otherBenefits: "Other benefits", revenue: "Monthly gross revenue", rate: "Estimated taxes (%)", accountant: "Accountant", operational: "Operating costs", pjHealth: "Health insurance", social: "Social security/contribution", otherCosts: "Other costs", vacationReserve: "Vacation reserve", bonusReserve: "13th-salary equivalent reserve", cltGross: "Gross salary", inss: "INSS", irrf: "IRRF", net: "Monthly net", thirteenth: "Estimated 13th net pay", vacation: "Vacation bonus", fgts: "FGTS (monthly asset)", economicMonthly: "Monthly economic value", economicAnnual: "Annual economic value", taxes: "Estimated taxes", costs: "Costs", reserves: "Reserves", before: "Net before reserves", available: "Monthly available net", annual: "Annual net", difference: "Monthly economic difference", annualDiff: "Annual difference", winner: "Higher value", equivalent: "Equivalent PJ revenue", cltWinner: "CLT", pjWinner: "PJ", tie: "Tie", note: "The 12 salaries already include the vacation month; only the one-third bonus is added. FGTS is an asset, not available income. The 13th payment is calculated separately and conservatively.", privacy: "Calculations stay in your browser." },
  es: { back: "Volver", category: "Finanzas", intro: "Compara el paquete económico CLT brasileño con una propuesta PJ. Los impuestos PJ son una estimación indicada por ti.", country: "País", soon: "Próximamente", soonText: "Esta calculadora aún no está disponible para este país. Registramos tu interés para priorizar una versión local.", clt: "Escenario CLT (Brasil)", pj: "Escenario PJ (Brasil)", results: "Resultados", grossSalary: "Salario bruto mensual", dependents: "Dependientes", benefits: "Beneficios generales mensuales", meal: "Vale de comida", health: "Seguro médico", otherBenefits: "Otros beneficios", revenue: "Facturación bruta mensual", rate: "Impuestos estimados (%)", accountant: "Contador", operational: "Costos operativos", pjHealth: "Seguro médico", social: "Previsión/contribución", otherCosts: "Otros costos", vacationReserve: "Reserva para vacaciones", bonusReserve: "Reserva equivalente al 13º", cltGross: "Salario bruto", inss: "INSS", irrf: "IRRF", net: "Neto mensual", thirteenth: "13º neto estimado", vacation: "Adicional de vacaciones", fgts: "FGTS (patrimonio mensual)", economicMonthly: "Valor económico mensual", economicAnnual: "Valor económico anual", taxes: "Impuestos estimados", costs: "Costos", reserves: "Reservas", before: "Neto antes de reservas", available: "Neto mensual disponible", annual: "Neto anual", difference: "Diferencia económica mensual", annualDiff: "Diferencia anual", winner: "Mayor valor", equivalent: "Facturación PJ equivalente", cltWinner: "CLT", pjWinner: "PJ", tie: "Empate", note: "Los 12 salarios ya incluyen el mes de vacaciones; solo se suma el adicional de un tercio. El FGTS es patrimonio, no renta disponible. El 13º se calcula por separado y de forma conservadora.", privacy: "Los cálculos se realizan en tu navegador." },
}[locale];
const backRoute = locale === "pt-BR" ? "/ferramentas/" : locale === "es" ? "/es/herramientas/" : "/en/tools/";
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
---
<Layout title={toolMeta.title} description={toolMeta.description} canonical={canonicalUrl} alternateUrls={getSiteAlternates(Astro.url.pathname)} locale={locale}>
  <main><div class="container">
    <a class="back" href={backRoute}>← {copy.back}</a><div class="eyebrow">{copy.category}</div><h1>{toolMeta.title}</h1><p>{copy.intro}</p>
    <label>{copy.country}<select id="countrySelector"></select></label>
    <div id="comingSoon" hidden><h2>{copy.soon}</h2><p>{copy.soonText}</p></div>
    <div id="calculator">
      <div class="grid"><section><h2>{copy.clt}</h2><label>{copy.grossSalary}<input id="grossSalary" type="number" min="0" step="0.01" value="7000" /></label><label>{copy.dependents}<input id="dependents" type="number" min="0" step="1" value="0" /></label><label>{copy.benefits}<input id="benefits" type="number" min="0" step="0.01" value="0" /></label><label>{copy.meal}<input id="mealVoucher" type="number" min="0" step="0.01" value="500" /></label><label>{copy.health}<input id="healthInsurance" type="number" min="0" step="0.01" value="300" /></label><label>{copy.otherBenefits}<input id="otherBenefits" type="number" min="0" step="0.01" value="200" /></label></section>
      <section><h2>{copy.pj}</h2><label>{copy.revenue}<input id="contractorIncome" type="number" min="0" step="0.01" value="6500" /></label><label>{copy.rate}<input id="taxRatePercent" type="number" min="0" max="100" step="0.01" value="15" /></label><label>{copy.accountant}<input id="accountingCosts" type="number" min="0" step="0.01" value="300" /></label><label>{copy.operational}<input id="businessCosts" type="number" min="0" step="0.01" value="0" /></label><label>{copy.pjHealth}<input id="contractorHealthInsurance" type="number" min="0" step="0.01" value="0" /></label><label>{copy.social}<input id="contractorSocialSecurity" type="number" min="0" step="0.01" value="0" /></label><label>{copy.otherCosts}<input id="contractorOtherCosts" type="number" min="0" step="0.01" value="0" /></label><label>{copy.vacationReserve}<input id="vacationReserve" type="number" min="0" step="0.01" value="0" /></label><label>{copy.bonusReserve}<input id="thirteenthReserve" type="number" min="0" step="0.01" value="0" /></label></section></div>
      <p id="validation" role="alert"></p><section id="results"><h2>{copy.results}</h2><div class="grid"><div><h3>CLT</h3><dl data-group="employee"></dl></div><div><h3>PJ</h3><dl data-group="contractor"></dl></div><div><h3>{copy.results}</h3><dl data-group="comparison"></dl><div class="bar"><span id="cltBar"></span></div><div class="bar"><span id="pjBar"></span></div></div></div><p>{copy.note}</p></section>
    </div><p>{copy.privacy}</p>
  </div></main>
  <script id="calculatorConfig" type="application/json" set:html={JSON.stringify({ locale, copy })}></script>
  <script>
    import { calculateComparison } from "../../lib/calculators/clt-vs-pj"; import { brazil2026Profile } from "../../data/countries/br/2026/profile";
    const { locale, copy } = JSON.parse(document.querySelector("#calculatorConfig").textContent);
    const countries = [{ code: "BR", label: "Brasil", status: "validated" }, { code: "US", label: "United States", status: "planned" }, { code: "PT", label: "Portugal", status: "planned" }, { code: "ES", label: "España", status: "planned" }, { code: "GB", label: "United Kingdom", status: "planned" }, { code: "CA", label: "Canada", status: "planned" }, { code: "AU", label: "Australia", status: "planned" }, { code: "DE", label: "Deutschland", status: "planned" }];
    const countryNames = {
      "pt-BR": { BR: "Brasil", US: "Estados Unidos", PT: "Portugal", ES: "Espanha", GB: "Reino Unido", CA: "Canadá", AU: "Austrália", DE: "Alemanha" },
      en: { BR: "Brazil", US: "United States", PT: "Portugal", ES: "Spain", GB: "United Kingdom", CA: "Canada", AU: "Australia", DE: "Germany" },
      es: { BR: "Brasil", US: "Estados Unidos", PT: "Portugal", ES: "España", GB: "Reino Unido", CA: "Canadá", AU: "Australia", DE: "Alemania" },
    };
    const validationCopy = {
      "pt-BR": { required: "O campo {field} é obrigatório.", number: "O campo {field} deve ser um número válido.", negative: "O campo {field} não pode ser negativo.", integer: "O campo {field} deve ser um número inteiro.", rate: "Os impostos estimados devem estar entre 0 e 100%.", unavailable: "Este país não está disponível para cálculo." },
      en: { required: "{field} is required.", number: "{field} must be a valid number.", negative: "{field} cannot be negative.", integer: "{field} must be a whole number.", rate: "Estimated taxes must be between 0 and 100%.", unavailable: "This country is not available for calculation." },
      es: { required: "El campo {field} es obligatorio.", number: "El campo {field} debe ser un número válido.", negative: "El campo {field} no puede ser negativo.", integer: "El campo {field} debe ser un número entero.", rate: "Los impuestos estimados deben estar entre 0 y 100%.", unavailable: "Este país no está disponible para cálculo." },
    }[locale];
    const fieldLabels = { grossSalary: copy.grossSalary, dependents: copy.dependents, benefits: copy.benefits, mealVoucher: copy.meal, healthInsurance: copy.health, otherBenefits: copy.otherBenefits, contractorIncome: copy.revenue, taxRatePercent: copy.rate, accountingCosts: copy.accountant, businessCosts: copy.operational, contractorHealthInsurance: copy.pjHealth, contractorSocialSecurity: copy.social, contractorOtherCosts: copy.otherCosts, vacationReserve: copy.vacationReserve, thirteenthReserve: copy.bonusReserve };
    const localizeIssue = (issue) => {
      if (issue === "This country is not available for calculation.") return validationCopy.unavailable;
      if (issue === "taxRatePercent must be between 0 and 100.") return validationCopy.rate;
      const match = issue.match(/^(\\w+) (is required\\.|must be a valid number\\.|cannot be negative\\.|must be a whole number\\.)$/);
      if (!match) return issue;
      const template = match[2] === "is required." ? validationCopy.required : match[2] === "must be a valid number." ? validationCopy.number : match[2] === "cannot be negative." ? validationCopy.negative : validationCopy.integer;
      return template.replace("{field}", fieldLabels[match[1]] ?? match[1]);
    };
    const selector = document.querySelector("#countrySelector"); const calculator = document.querySelector("#calculator"); const comingSoon = document.querySelector("#comingSoon"); const validation = document.querySelector("#validation"); const ids = ["grossSalary","dependents","benefits","mealVoucher","healthInsurance","otherBenefits","contractorIncome","taxRatePercent","accountingCosts","businessCosts","contractorHealthInsurance","contractorSocialSecurity","contractorOtherCosts","vacationReserve","thirteenthReserve"];
    countries.forEach((country) => { const option = document.createElement("option"); option.value = country.code; option.textContent = countryNames[locale][country.code]; selector.append(option); });
    const requested = new URLSearchParams(location.search).get("country")?.trim().toUpperCase(); selector.value = countries.some((item) => item.code === requested) ? requested : "BR";
    const money = new Intl.NumberFormat(locale === "pt-BR" ? "pt-BR" : locale === "es" ? "es-ES" : "en-US", { style: "currency", currency: "BRL" }); let recordedCountry = "";
    const addRows = (group, rows) => { const root = document.querySelector(`[data-group="${group}"]`); root.replaceChildren(...rows.flatMap(([label, value]) => { const dt = document.createElement("dt"), dd = document.createElement("dd"); dt.textContent = label; dd.textContent = money.format(value); return [dt, dd]; })); };
    const recordInterest = (country) => { if (country === recordedCountry) return; recordedCountry = country; window.dispatchEvent(new CustomEvent("calculator_country_interest", { detail: { country, calculator: "clt-vs-pj", locale } })); };
    const update = () => { const country = selector.value; history.replaceState({}, "", `${location.pathname}?country=${country}`); const active = country === "BR"; calculator.hidden = !active; comingSoon.hidden = active; if (!active) { recordInterest(country); return; } const inputs = Object.fromEntries(ids.map((id) => [id, document.getElementById(id).value])); const result = calculateComparison({ countryProfile: brazil2026Profile, inputs: { ...inputs, country } }); validation.textContent = result.validation.issues.map(localizeIssue).join(" "); if (!result.validation.valid) { document.querySelector("#results").hidden = true; return; } document.querySelector("#results").hidden = false;
      const e = result.employee, p = result.contractor; addRows("employee", [[copy.cltGross,e.grossSalary],[copy.inss,e.inss],[copy.irrf,e.irrf],[copy.net,e.monthlyNet],[copy.benefits,e.benefits],[copy.thirteenth,e.thirteenthSalary],[copy.vacation,e.vacationBonus],[copy.fgts,e.fgts],[copy.economicMonthly,e.economicMonthlyValue],[copy.economicAnnual,e.economicAnnualValue]]); addRows("contractor", [[copy.revenue,p.grossRevenue],[copy.taxes,p.taxes],[copy.costs,p.costs],[copy.reserves,p.reserves],[copy.before,p.monthlyBeforeReserves],[copy.available,p.monthlyAvailable],[copy.annual,p.annualNet]]); const winner = result.monthlyDifference === 0 ? copy.tie : result.monthlyDifference > 0 ? copy.pjWinner : copy.cltWinner; addRows("comparison", [[copy.difference,result.monthlyDifference],[copy.annualDiff,result.annualDifference],[copy.equivalent,result.equivalentContractorIncome]]); const group = document.querySelector('[data-group="comparison"]'); const dt=document.createElement("dt"),dd=document.createElement("dd");dt.textContent=copy.winner;dd.textContent=winner;group.append(dt,dd); document.querySelector("#cltBar").style.width=`${result.employeeShare}%`;document.querySelector("#pjBar").style.width=`${result.contractorShare}%`; };
    selector.addEventListener("change", update); ids.forEach((id) => document.getElementById(id).addEventListener("input", update)); update();
  </script>
  <style>.container{max-width:1100px;margin:auto;padding:3rem 1rem;font-family:Arial,sans-serif;color:#172033}.back{display:inline-block;margin-bottom:1rem}.eyebrow{color:#315bea;font-weight:bold;text-transform:uppercase}h1{font-size:clamp(2rem,5vw,3rem)}label{display:block;margin:.75rem 0;font-weight:600}input,select{display:block;width:100%;padding:.65rem;margin-top:.3rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}section,#comingSoon{padding:1.5rem;border:1px solid #e7ebf3;border-radius:12px;margin:1.5rem 0}dl{display:grid;grid-template-columns:1fr auto;gap:.45rem}dt{color:#475467}.bar{height:12px;background:#edf1f7;border-radius:8px;margin:.5rem 0;overflow:hidden}.bar span{display:block;height:100%;background:#315bea}#pjBar{background:#7aa2ff}#validation{color:#b42318}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
</Layout>
