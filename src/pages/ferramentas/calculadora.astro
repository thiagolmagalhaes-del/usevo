---
import { getFerramentaByPath, getFerramentaTranslation } from "../../data/ferramentas";
import { getSiteAlternates } from "../../data/locale-routes";
const ferramenta = getFerramentaByPath(Astro.url.pathname);
const toolMeta = getFerramentaTranslation(ferramenta, "en");
const title = toolMeta.title;
const description = toolMeta.description;
const canonicalUrl = new URL(Astro.url.pathname, "https://usevo.tools").href;
const alternateUrls = getSiteAlternates(Astro.url.pathname);
---



<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | USEVO TOOLS</title>
  <meta name="description" content={description} />
  <link rel="alternate" hreflang="pt-BR" href={alternateUrls["pt-BR"]} />
  <link rel="alternate" hreflang="en" href={alternateUrls.en} />
  <link rel="alternate" hreflang="es" href={alternateUrls.es} />
  <link rel="canonical" href={canonicalUrl} />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f8f9fc;
      color: #172033;
    }

    header {
      border-bottom: 1px solid #e7e9ef;
      background: white;
    }

    .header-inner {
      max-width: 1100px;
      margin: auto;
      padding: 22px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      text-decoration: none;
      color: #172033;
      font-size: 24px;
      font-weight: 800;
    }

    .back {
      text-decoration: none;
      color: #526174;
      font-size: 14px;
    }

    main {
      max-width: 760px;
      margin: 70px auto;
      padding: 0 24px;
    }

    .badge {
      display: inline-block;
      background: #eef2ff;
      color: #315bdc;
      padding: 7px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 18px;
    }

    h1 {
      font-size: 42px;
      margin: 0 0 12px;
    }

    .description {
      color: #687386;
      font-size: 17px;
      margin-bottom: 35px;
    }

    .calculator {
      background: white;
      border: 1px solid #e5e8ef;
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 12px 35px rgba(20, 30, 50, 0.06);
    }

    input {
      width: 100%;
      padding: 16px;
      border: 1px solid #dfe3ea;
      border-radius: 12px;
      font-size: 20px;
      margin-bottom: 15px;
      outline: none;
    }

    input:focus {
      border-color: #315bdc;
    }

    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 10px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 16px;
      font-size: 18px;
      cursor: pointer;
      background: #eef2ff;
      color: #315bdc;
      font-weight: 700;
    }

    button:hover {
      background: #dfe6ff;
    }

    .equals {
      background: #315bdc;
      color: white;
    }

    .equals:hover {
      background: #264bc0;
    }

    .clear {
      background: #f1f3f6;
      color: #555f70;
    }

    .result {
      margin-top: 25px;
      padding: 20px;
      background: #f7f8fb;
      border-radius: 14px;
      font-size: 28px;
      font-weight: 700;
      text-align: center;
      min-height: 70px;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 34px;
      }

      .buttons {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="header-inner">
      <a href="/" class="logo">USEVO TOOLS</a>
      <a href="/ferramentas" class="back">← Back to tools</a>
    </div>
  </header>

  <main>
    <span class="badge">Calculators</span>

    <h1>Calculator</h1>

    <p class="description">
      Do quick calculations right in your browser.
    </p>

    <div class="calculator">

      <input
        id="display"
        type="text"
        placeholder="Type a calculation..."
        readonly
      />

      <div class="buttons">
        <button onclick="add('7')">7</button>
        <button onclick="add('8')">8</button>
        <button onclick="add('9')">9</button>
        <button onclick="add('/')">÷</button>

        <button onclick="add('4')">4</button>
        <button onclick="add('5')">5</button>
        <button onclick="add('6')">6</button>
        <button onclick="add('*')">×</button>

        <button onclick="add('1')">1</button>
        <button onclick="add('2')">2</button>
        <button onclick="add('3')">3</button>
        <button onclick="add('-')">−</button>

        <button onclick="add('0')">0</button>
        <button onclick="add('.')">.</button>
        <button class="equals" onclick="calculate()">=</button>
        <button onclick="add('+')">+</button>

        <button onclick="clearDisplay()" class="clear">Clear</button>
      </div>

      <div class="result" id="result">
        0
      </div>

    </div>
  </main>

  <script>
    const display = document.getElementById("display");
    const result = document.getElementById("result");

    function add(value) {
      display.value += value;
    }

    function clearDisplay() {
      display.value = "";
      result.textContent = "0";
    }

    function calculate() {
      try {
        if (!display.value.trim()) return;

        const expression = display.value.replace(/[^0-9+\-*/.() ]/g, "");
        const answer = Function('"use strict"; return (' + expression + ')')();

        if (!Number.isFinite(answer)) {
          result.textContent = "Error";
          return;
        }

        result.textContent = answer;
      } catch {
        result.textContent = "Invalid expression";
      }
    }
  </script>

</body>
</html>