---
import Layout from "../layouts/Layout.astro";
import CatalogBrowser from "../components/tool/CatalogBrowser.astro";
import { getTranslations } from "../data/i18n";
import { getSiteAlternates } from "../data/locale-routes";

const t = getTranslations("pt-BR");
const alternateUrls = getSiteAlternates("/ferramentas/");
---

<Layout title="All tools — USEVO TOOLS" description="Explore every tool available on USEVO TOOLS. Simple, fast, and useful online tools to solve everyday tasks." locale="pt-BR" canonical="https://usevo.tools/ferramentas/" alternateUrls={alternateUrls}>
  <CatalogBrowser locale="pt-BR" />
</Layout>
